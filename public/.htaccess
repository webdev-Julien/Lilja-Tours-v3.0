# =====================================================
# Lilja Tours - .htaccess Configuration
# Hosted on HostGator
# =====================================================

# Enable RewriteEngine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} ^lilja-tours\.com [NC]
RewriteRule ^(.*)$ https://www.lilja-tours.com/$1 [L,R=301]

# Remove trailing slash (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# =====================================================
# 301 REDIRECTS - OLD URLs to NEW URLs
# =====================================================
# Instructions: Replace [NEW-URL] with the actual new URL path
# Format: RedirectMatch 301 ^/old-path/?$ https://www.lilja-tours.com/[NEW-URL]
# =====================================================

# -----------------------------------------------------
# MAIN PAGES
# -----------------------------------------------------
RedirectMatch 301 ^/about/?$ https://www.lilja-tours.com/
RedirectMatch 301 ^/all-day-tours/?$ https://www.lilja-tours.com/
RedirectMatch 301 ^/multiday/?$ https://www.lilja-tours.com/
RedirectMatch 301 ^/things-to-do-in-iceland/?$ https://www.lilja-tours.com/

# -----------------------------------------------------
# DAY TOUR CATEGORIES (redirect to main day tours page)
# -----------------------------------------------------
RedirectMatch 301 ^/day-tours-iceland/?$ https://www.lilja-tours.com/
RedirectMatch 301 ^/day-tours-iceland/adventure/?$ https://www.lilja-tours.com/
