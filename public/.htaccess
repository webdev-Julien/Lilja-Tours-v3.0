# =====================================================
# Lilja Tours - .htaccess Configuration
# Hosted on HostGator | Cloudflare Active
# =====================================================


# Enable RewriteEngine
RewriteEngine On


# HTTPS redirect removed - handled by Cloudflare "Always Use HTTPS" setting
# (SSL/TLS → Edge Certificates → Always Use HTTPS)


# Force www
RewriteCond %{HTTP_HOST} ^lilja-tours\\.com [NC]
RewriteRule ^(.*)$ https://www.lilja-tours.com/$1 [L,R=301]


# Remove trailing slash (except for directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]


# =====================================================
# 301 REDIRECTS - OLD URLs to NEW URLs
# =====================================================


# =====================================================
# -----------------------------------------------------
# MAIN PAGES
# -----------------------------------------------------


RedirectMatch 301 ^/all-day-tours/?$ https://www.lilja-tours.com/private-day-tours-iceland/
RedirectMatch 301 ^/multiday/?$ https://www.lilja-tours.com/multiday-tours-iceland/
RedirectMatch 301 ^/things-to-do-in-iceland/?$ https://www.lilja-tours.com/partner-experiences-iceland/
RedirectMatch 301 ^/lander/?$ https://www.lilja-tours.com/


# -----------------------------------------------------
# DAY TOUR CATEGORIES (redirect to main day tours page)
# -----------------------------------------------------


RedirectMatch 301 ^/day-tours-iceland/?$ https://www.lilja-tours.com/private-day-tours-iceland/
