# -----------------------------------------------------


RedirectMatch 301 ^/booking/(.*)$ https://www.lilja-tours.com/contact/


# -----------------------------------------------------
# UNDEFINED URL BUG CATCHES
# -----------------------------------------------------


RedirectMatch 301 ^/(.+)/undefined/?$ https://www.lilja-tours.com/$1/


