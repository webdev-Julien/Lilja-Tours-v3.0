---
import "../../../src/styles/global.css"
import Topbar from "../../components/Topbar.astro"
import BlogCard from "../../components/BlogCard.astro"
import Footer from "../../components/Footer.astro"
import { getCollection } from 'astro:content';

// Get all blog articles from the collection
const allArticles = await getCollection('blog_articles_EN');

// Sort articles by publish date (newest first)
const sortedArticles = allArticles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Explore our blog for Iceland travel tips, destination guides, photography insights, and insider knowledge about experiencing Iceland like a local.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/blog/" />
		<link rel="canonical" href="https://www.lilja-tours.com/blog/" />

		<meta property="og:title" content="Iceland Travel Blog - Tips, Guides & Stories | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content="https://www.lilja-tours.com/videos/blog-bg.webp">
		<meta property="og:url" content="https://www.lilja-tours.com/blog/">
		<meta property="og:description" content="Explore our blog for Iceland travel tips, destination guides, photography insights, and insider knowledge about experiencing Iceland like a local.">

		<meta property="og:locale" content="en_US">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<link rel="icon" href="/favicon.ico" type="image/x-icon">
		<meta name="generator" content={Astro.generator} />
		<title>Iceland Travel Blog - Tips, Guides & Stories | Lilja Tours</title>

		<!-- Google tag (gtag.js) -->
		<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>


		<style is:inline>
			/* Minimal CSS for features not available in Tailwind */
			.fade-in {
				opacity: 0;
				transition: opacity 0.8s ease-out;
			}

			.fade-in.visible {
				opacity: 1;
			}

			.slide-up {
				opacity: 0;
				transform: translateY(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-up.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-down {
				opacity: 0;
				transform: translateY(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-down.visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Mobile responsive adjustments for complex layout behaviors */
			@media (max-width: 768px) {
				.bg-fixed {
					background-attachment: scroll;
				}
			}

			/* Video header styles */
			.video-header {
				position: relative;
				overflow: hidden;
			}

			.video-header video {
				position: absolute;
				top: 50%;
				left: 50%;
				min-width: 100%;
				min-height: 100%;
				width: auto;
				height: auto;
				transform: translate(-50%, -50%);
				object-fit: cover;
				z-index: -1;
			}

			.video-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.4);
				z-index: 1;
			}

			.video-content {
				position: relative;
				z-index: 2;
			}

			/* Ensure all blog cards have equal height and aligned content */
			.blog-grid {
				display: grid;
				align-items: stretch;
			}

			.blog-grid > * {
				height: 100%;
				display: flex;
				flex-direction: column;
			}

			.blog-grid article > div {
				height: 100%;
				display: flex;
				flex-direction: column;
			}
		</style>
	</head>
	<body>

			<!-- Video Header Section -->
			<header class="video-header h-[75dvh] flex items-center justify-center relative">
						<Topbar frenchUrl="#" currentLang="en" />
				<!-- Desktop HD Video (1024px and above) -->
				<video
					id="video-desktop"
					autoplay
					muted
					loop
					playsinline
					class="video-source absolute inset-0 w-full h-full object-cover hidden lg:block"
				>
					<source src="/videos/HD/blog-bg-hd.mp4" type="video/mp4">
					<source src="/videos/HD/blog-bg-hd.webm" type="video/webm">
				</video>

				<!-- Tablet Medium Video (768px to 1023px) -->
				<video
					id="video-tablet"
					autoplay
					muted
					loop
					playsinline
					class="video-source absolute inset-0 w-full h-full object-cover hidden md:block lg:hidden"
				>
					<source src="/videos/MD/blog-bg-medium.mp4" type="video/mp4">
					<source src="/videos/MD/blog-bg-medium.webm" type="video/webm">
				</video>

				<!-- Mobile Vertical Video (0px to 767px) -->
				<video
					id="video-mobile"
					autoplay
					muted
					loop
					playsinline
					class="video-source absolute inset-0 w-full h-full object-cover block md:hidden"
				>
					<source src="/videos/SD/blog-bg-mobile.mp4" type="video/mp4">
					<source src="/videos/SD/blog-bg-mobile.webm" type="video/webm">
				</video>

				<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Iceland Travel Blog</h1>
					<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide">
						Discover insider tips, destination guides, and stories from Iceland. Expert advice for planning your perfect Iceland adventure.
					</p>
				</div>
			</header>

			<!-- Blog Articles Grid Section -->
			<section class="bg-gray-50 py-28 px-6">
				<div class="max-w-7xl mx-auto">
					<div class="text-center mb-16 slide-up">
						<h2 class="text-4xl md:text-5xl font-light text-[#5b7297] mb-6 tracking-tight">Latest Articles</h2>
						<p class="text-lg md:text-xl text-gray-500 font-light max-w-3xl mx-auto leading-relaxed">
							Explore Iceland through our curated collection of travel guides, tips, and stories
						</p>
					</div>

					<div class="blog-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center">
						{sortedArticles.map((article) => (
							<BlogCard
								image={article.data.cardImg.srcPC}
								imageAlt={article.data.cardImg.alt}
								title={article.data.title}
								excerpt={article.data.excerpt}
								publishDate={article.data.publishDate}
								readingTime={article.data.readingTime}
								categories={article.data.categories}
								slug={`/blog/${article.data.slug || article.slug}`}
								author={article.data.author}
							/>
						))}
					</div>
				</div>
			</section>

			<!-- Footer Section -->
			<Footer />

			<!-- Scroll Animation Script -->
			<script>
				document.addEventListener('DOMContentLoaded', function() {
					const observerOptions = {
						threshold: 0.1,
						rootMargin: '0px 0px -50px 0px'
					};

					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('visible');
							}
						});
					}, observerOptions);

					// Observe all elements with animation classes
					document.querySelectorAll('.fade-in, .slide-up, .slide-down').forEach(el => {
						observer.observe(el);
					});
				});
			</script>
	</body>
</html>
