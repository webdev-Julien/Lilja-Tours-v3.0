---
import "../../../src/styles/global.css"
import Topbar from "../../components/Topbar.astro"
import BlogCard from "../../components/BlogCard.astro"
import Footer from "../../components/Footer.astro"
import { getCollection } from 'astro:content';
import { getOgImageUrl } from '../../utils/images';

// Get all blog articles from the collection
const allArticles = await getCollection('blog_articles_EN');

// Sort articles by publish date (newest first)
const sortedArticles = allArticles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const ogImage = getOgImageUrl('/pictures/index/experiences-bg.jpg');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Browse all Iceland travel articles from Lilja Tours. Complete collection of travel guides, tips, destination guides, and stories to plan your Iceland adventure.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/blog/all-articles/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/blog/all-articles/" />
		<link rel="canonical" href="https://www.lilja-tours.com/blog/all-articles/" />

		<meta property="og:title" content="All Articles - Iceland Travel Blog | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImage}>
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:url" content="https://www.lilja-tours.com/blog/all-articles/">
		<meta property="og:description" content="Browse all Iceland travel articles from Lilja Tours. Complete collection of travel guides and stories.">

		<meta property="og:locale" content="en_US">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>All Articles - Iceland Travel Blog | Lilja Tours</title>

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

		<style is:inline>
			/* Animation classes */
			.fade-in {
				opacity: 0;
				transition: opacity 0.8s ease-out;
			}

			.fade-in.visible {
				opacity: 1;
			}

			.slide-up {
				opacity: 0;
				transform: translateY(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-up.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-down {
				opacity: 0;
				transform: translateY(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-down.visible {
				opacity: 1;
				transform: translateY(0);
			}

			/* Blog grid */
			.blog-grid {
				display: grid;
				align-items: stretch;
			}

			.blog-grid > * {
				height: 100%;
				display: flex;
				flex-direction: column;
			}

			.blog-grid article > div {
				height: 100%;
				display: flex;
				flex-direction: column;
			}

			/* Header background styles */
			.header-bg {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				z-index: 0;
			}

			.header-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.5);
				z-index: 1;
			}

			.header-content {
				position: relative;
				z-index: 2;
			}

			/* Back button hover effect */
			.back-button::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: white;
				transform: translateY(-100%);
				transition: transform 0.6s ease;
				z-index: -1;
			}

			.back-button:hover::before {
				transform: translateY(0);
			}

			.back-button:hover {
				color: #5b7297;
			}

			/* Video header styles */
			.video-header {
				position: relative;
				overflow: hidden;
			}

			.video-header video {
				position: absolute;
				top: 50%;
				left: 50%;
				min-width: 100%;
				min-height: 100%;
				width: auto;
				height: auto;
				transform: translate(-50%, -50%);
				object-fit: cover;
				z-index: -1;
			}

			.video-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.4);
				z-index: 1;
			}

			.video-content {
				position: relative;
				z-index: 2;
			}

			/* Mobile responsive adjustments */
			@media (max-width: 768px) {
				.bg-fixed {
					background-attachment: scroll;
				}
			}
		</style>
	</head>
	<body>
		<Topbar currentLang="en" frenchUrl="/fr/blog/all-articles/" />

		<!-- Video Header Section -->
		<header class="video-header h-[60dvh] flex items-center justify-center relative">
			<!-- Desktop HD Video (1024px and above) -->
			<video
				id="video-desktop"
				autoplay
				muted
				loop
				playsinline
				class="video-source absolute inset-0 w-full h-full object-cover hidden lg:block"
			>
				<source src="/videos/HD/blog-bg.mp4" type="video/mp4">
			</video>

			<!-- Tablet Medium Video (768px to 1023px) -->
			<video
				id="video-tablet"
				autoplay
				muted
				loop
				playsinline
				class="video-source absolute inset-0 w-full h-full object-cover hidden md:block lg:hidden"
			>
				<source src="/videos/MD/blog-bg.mp4" type="video/mp4">
			</video>

			<!-- Mobile Vertical Video (0px to 767px) -->
			<video
				id="video-mobile"
				autoplay
				muted
				loop
				playsinline
				class="video-source absolute inset-0 w-full h-full object-cover block md:hidden"
			>
				<source src="/videos/SD/blog-bg.mp4" type="video/mp4">
			</video>

			<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
				<div class="mb-6">
					<a
						href="/blog/"
						class="back-button inline-flex items-center gap-2 px-5 py-2.5 bg-transparent text-white border border-white rounded-sm font-light text-sm tracking-wide uppercase relative overflow-hidden hover:text-[#5b7297] transition-colors duration-300"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
						</svg>
						Back to Blog Home
					</a>
				</div>
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">All Articles</h1>
				<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide">
					Explore our complete collection of {sortedArticles.length} Iceland travel {sortedArticles.length === 1 ? 'article' : 'articles'}
				</p>
			</div>
		</header>

		<main>
			<!-- All Articles Section -->
			<section class="bg-gray-50 py-28 px-6">
				<div class="max-w-7xl mx-auto">
					<div class="blog-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center fade-in">
						{sortedArticles.map((article) => (
							<BlogCard
								image={article.data.cardImg.srcPC}
								imageAlt={article.data.cardImg.alt}
								title={article.data.title}
								excerpt={article.data.excerpt}
								publishDate={article.data.publishDate}
								readingTime={article.data.readingTime}
								categories={article.data.categories}
								slug={`/blog/${article.data.slug || article.slug}/`}
								author={article.data.author}
							/>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer />

		<script>
			// Intersection Observer for scroll animations
			function initScrollAnimations() {
				const observerOptions = {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, observerOptions);

				const animatedElements = document.querySelectorAll('.fade-in, .slide-up, .slide-down');
				animatedElements.forEach((element) => {
					observer.observe(element);
				});
			}

			document.addEventListener('DOMContentLoaded', initScrollAnimations);
		</script>
	</body>
</html>
