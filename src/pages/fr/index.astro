---
import "../../styles/global.css"
import HomeHeader from "../../components/HomeHeader.astro"
import ItineraryCard from "../../components/ItineraryCard.astro"
import BlogCard from "../../components/BlogCard.astro"
import { getCollection } from 'astro:content';
import CTAButton from "../../components/CTAButton.astro";
import Footer from "../../components/Footer.astro";

// Get all tours and randomly select 3 to display on homepage
const allTours = await getCollection('tours_FR');

// Shuffle function using Fisher-Yates algorithm
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

// Randomly select 3 tours at build time
const selectedTours = shuffleArray(allTours).slice(0, 3);

// Get latest 3 blog articles
const allBlogArticles = await getCollection('blog_articles_FR');
const latestArticles = allBlogArticles
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);
