---
// French All Articles Page - Simple listing of all blog articles
import "../../../styles/global.css"
import Topbar from "../../../components/Topbar.astro"
import BlogCard from "../../../components/BlogCard.astro"
import Footer from "../../../components/Footer.astro"
import { getCollection } from 'astro:content';

const allArticles = await getCollection('blog_articles_FR');
const sortedArticles = allArticles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="[FR TRANSLATION NEEDED] Browse all Iceland travel articles.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/blog/all-articles/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/blog/all-articles/" />
		<link rel="canonical" href="https://www.lilja-tours.com/fr/blog/all-articles/" />

		<meta property="og:title" content="[FR] All Articles | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:url" content="https://www.lilja-tours.com/fr/blog/all-articles/">

		<meta property="og:locale" content="fr_FR">
		<link rel="icon" href="/favicon.ico" type="image/x-icon">
		<title>[FR] All Articles | Lilja Tours</title>

		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-48C94854K2');</script>
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>
	</head>
	<body>
		<Topbar englishUrl="/blog/all-articles/" currentLang="fr" />
		<main class="bg-gray-50 py-28 px-6">
			<div class="max-w-7xl mx-auto">
				<h1 class="text-5xl md:text-6xl font-light text-[#5b7297] mb-16 text-center">[FR] All Articles</h1>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center">
					{sortedArticles.map((article) => (
						<BlogCard
							image={article.data.cardImg.srcPC}
							imageAlt={article.data.cardImg.alt}
							title={article.data.title}
							excerpt={article.data.excerpt}
							publishDate={article.data.publishDate}
							readingTime={article.data.readingTime}
							categories={article.data.categories}
							slug={`/fr/blog/${article.data.slug || article.slug}`}
							author={article.data.author}
						/>
					))}
				</div>
			</div>
		</main>
		<Footer currentLang="fr" />
	</body>
</html>
