---
import "../../../styles/global.css"
import "../../../styles/private-day-tours.css"
import Topbar from "../../../components/Topbar.astro"
import ItineraryCard from "../../../components/ItineraryCard.astro"
import Footer from "../../../components/Footer.astro"
import OptimizedImage from "../../../components/OptimizedImage.astro"
import { getOgImageUrl } from "../../../utils/images"
import { getCollection } from 'astro:content';

// Get all French tours from the collection
const allTours = await getCollection('tours_FR');

// Generate optimized OG image URL
const ogImageUrl = getOgImageUrl("/pictures/index/multiday-bg.jpg");
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Découvrez toutes nos excursions à la jounrée en Islande. Explorez les sites les plus spectaculaires avec un guide francophone expert.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/private-day-tours-iceland/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/circuits-prives-islande/" />
		<link rel="canonical" href="https://www.lilja-tours.com/fr/circuits-prives-islande/" />

		<meta property="og:title" content="Circuits Privés d'une Journée en Islande | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content="Circuits privés en Islande avec Lilja Tours">
		<meta property="og:url" content="https://www.lilja-tours.com/fr/circuits-prives-islande/">
		<meta property="og:description" content="Découvrez toutes nos excursions à la jounrée en Islande. Explorez les sites les plus spectaculaires avec un guide francophone expert.">

		<meta property="og:locale" content="fr_FR">
		<meta property="og:locale:alternate" content="en_US">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>Circuits Privés d'une Journée en Islande | Lilja Tours</title>

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			// Set linker before the config command
			gtag('set', 'linker', {
				'domains': ['bokun.io']
			});

			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>

		<!-- Resource Preloading for Performance -->
		<link rel="preload" href="/logos/topbar-logo.webp" as="image" fetchpriority="high">
		<link rel="preload" href="/videos/tours-bg.webp" as="image">
		<link rel="preconnect" href="https://www.googletagmanager.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>
	</head>
	<body>

			<!-- Video Header Section -->
			<header class="video-header h-[75dvh] flex items-center justify-center relative">
						<Topbar englishUrl="/private-day-tours-iceland/" currentLang="fr" />
				<video
					autoplay
					muted
					loop
					playsinline
					preload="auto"
					poster="/videos/tours-bg.webp"
					aria-label="Iceland landscape background video"
					class="video-source absolute inset-0 w-full h-full object-cover"
				>
					<source src="/videos/HD/tours-bg-hd.mp4" type="video/mp4" media="(min-width: 1024px)">
					<source src="/videos/MD/tours-bg-medium.mp4" type="video/mp4" media="(min-width: 768px) and (max-width: 1023px)">
					<source src="/videos/SD/tours-bg-mobile.mp4" type="video/mp4" media="(max-width: 767px)">
				</video>

				<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Excursions guidées, à la journée en Islande</h1>
					<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide">
						Nos excursions avec chauffeur-guide privé en Islande vous permettent de découvrir les destinations les plus spectaculaires du pays.
					</p>
				</div>
			</header>
		<main>

			<!-- Tours Grid Section -->
			<section class="fade-in visible bg-white py-32">
				<div class="max-w-7xl w-full mx-auto px-8">
					<div class="text-center mb-16 max-w-4xl mx-auto slide-up visible">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Nos excursions prêtes à réserver</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide mb-8">
							Choisissez parmi notre collection d'excursions à la journée.
						</p>
						<p class="text-base md:text-lg font-light leading-relaxed text-gray-500 tracking-wide mb-8">
							Tous nos excursions guidées sont entièrement personnalisables selon vos intérêts.
						</p>
						<a href="/fr/contact/" class="contact-cta-button inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline border border-[#5b7297] rounded-sm font-light text-sm transition-all duration-300 flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:text-white hover:translate-x-px">
							Contactez-nous pour personnalisation
						</a>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 mt-16 items-start justify-items-center slide-up visible">
						{allTours.map((tour) => (
							<ItineraryCard
								image={tour.data.cardImg?.srcPC || tour.data.featuredImage}
								imageAlt={tour.data.cardImg?.alt || tour.data.title}
								title={tour.data.title}
								duration={tour.data.duration}
								description={tour.data.cardSentence}
								price={`${tour.data.price}`}
								highlights={tour.data.highlights?.slice(0, 3)}
								season={tour.data.season}
								slug={tour.data.url}
								currentLang="fr"
							/>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer currentLang="fr" />

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const observerOptions = {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, observerOptions);

				const animatedElements = document.querySelectorAll('.fade-in, .slide-up, .slide-down');
				animatedElements.forEach((element) => {
					observer.observe(element);
				});
			});
		</script>
	</body>
</html>
