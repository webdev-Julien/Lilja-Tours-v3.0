			"url": "https://www.lilja-tours.com/fr/conseillers-voyage/",
			"inLanguage": "fr",
			"mainEntity": {
				"@type": "LocalBusiness",
				"@id": "https://www.lilja-tours.com",
				"name": "Lilja Tours",
				"alternateName": "Lilja Tours Iceland DMC",
