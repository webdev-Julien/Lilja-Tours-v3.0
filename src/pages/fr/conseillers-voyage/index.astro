					"longitude": "-21.9426"
				},
				"priceRange": "€€€",
				"sameAs": [
					"https://www.facebook.com/liljatours",
					"https://www.instagram.com/lilja_tours",
					"https://www.tripadvisor.com/Attraction_Review-g189970-d23867059-Reviews-Lilja_Tours-Reykjavik_Capital_Region.html"
				],
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "5.0",
					"reviewCount": "150",
					"bestRating": "5",
					"worstRating": "1"
				},
				"makesOffer": [
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Services en marque blanche / Opérateur terrain",
							"description": "Opération de circuits en coulisses sous votre marque avec support opérationnel détaillé et communication en temps réel."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "DMC Service Complet",
							"description": "Conception d'itinéraires islandais sur mesure incluant hébergements, activités, restaurants, transferts et circuits guidés."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Services à la carte",
							"description": "Segments de circuits guidés flexibles, excursions à la journée, transferts aéroport et segments guidés multi-jours."
