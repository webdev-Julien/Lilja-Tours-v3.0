---
import "../../../styles/global.css"
import Topbar from "../../../components/Topbar.astro"
import Footer from "../../../components/Footer.astro"
import OptimizedImage from "../../../components/OptimizedImage.astro"
import { getOgImageUrl, getBackgroundImageUrl } from "../../../utils/images"

// Generate optimized image URLs
const ogImageUrl = getOgImageUrl("/pictures/index/travel-advisors-bg.jpg");
const backgroundImageUrl = getBackgroundImageUrl("/pictures/index/travel-advisors-bg.jpg");
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Devenez partenaire de Lilja Tours, DMC de luxe en Islande. Circuits privés guidés, opérations en marque blanche et conception d'itinéraires sur mesure pour agents de voyage.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/travel-advisors/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/conseillers-voyage/" />
		<link rel="canonical" href="https://www.lilja-tours.com/fr/conseillers-voyage/" />

		<meta property="og:title" content="Agents de Voyage — Partenariat Lilja Tours | DMC Islande">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:url" content="https://www.lilja-tours.com/fr/conseillers-voyage/">
		<meta property="og:description" content="Devenez partenaire de Lilja Tours, DMC de luxe en Islande. Circuits privés guidés, opérations en marque blanche et conception d'itinéraires sur mesure pour agents de voyage.">

		<meta property="og:locale" content="fr_FR">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>Agents de Voyage — Partenariat Lilja Tours | DMC Islande</title>

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			// Set linker before the config command
			gtag('set', 'linker', {
				'domains': ['bokun.io']
			});

			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>

		<script type="application/ld+json">
