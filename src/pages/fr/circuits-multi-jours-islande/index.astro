---
import "../../../styles/global.css"
import "../../../styles/private-day-tours.css"
import Topbar from "../../../components/Topbar.astro"
import MultidayItineraryCard from "../../../components/MultidayItineraryCard.astro"
import Footer from "../../../components/Footer.astro"
import OptimizedImage from "../../../components/OptimizedImage.astro"
import { getOgImageUrl } from "../../../utils/images"
import { getCollection } from 'astro:content';

const allMultidayTours = await getCollection('multiday_tours_FR');

// Generate optimized OG image URL
const ogImageUrl = getOgImageUrl("/pictures/index/multiday-bg.jpg");
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Explorez nos circuits multi-jours personnalisés en Islande. Des voyages sur mesure pour découvrir le pays avec un guide privé. Demandez votre devis !">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/multiday-tours-iceland/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/circuits-multi-jours-islande/" />
		<link rel="canonical" href="https://www.lilja-tours.com/fr/circuits-multi-jours-islande/" />

		<meta property="og:title" content="Circuits Multi-Jours en Islande | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:alt" content="Circuits multi-jours en Islande avec Lilja Tours">
		<meta property="og:url" content="https://www.lilja-tours.com/fr/circuits-multi-jours-islande/">
		<meta property="og:description" content="Explorez nos circuits multi-jours personnalisés en Islande. Des voyages sur mesure pour découvrir le pays avec un guide privé. Demandez votre devis !">

		<meta property="og:locale" content="fr_FR">
		<meta property="og:locale:alternate" content="en_US">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>Circuits Multi-Jours en Islande | Lilja Tours</title>

		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			// Set linker before the config command
			gtag('set', 'linker', {
				'domains': ['bokun.io']
			});

			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>

		<link rel="preload" href="/logos/topbar-logo.webp" as="image" fetchpriority="high">
		<link rel="preload" href="/videos/tours-bg.webp" as="image">

		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>
	</head>
	<body>
			<header class="video-header h-[75dvh] flex items-center justify-center relative">
						<Topbar englishUrl="/multiday-tours-iceland/" currentLang="fr" />
				<video
					autoplay muted loop playsinline preload="auto" poster="/videos/tours-bg.webp"
					aria-label="Iceland multiday tours background video"
					class="video-source absolute inset-0 w-full h-full object-cover"
				>
					<source src="/videos/HD/multiday-bg.mp4" type="video/mp4" media="(min-width: 1024px)">
					<source src="/videos/MD/multiday-bg.mp4" type="video/mp4" media="(min-width: 768px) and (max-width: 1023px)">
					<source src="/videos/SD/multiday-bg.mp4" type="video/mp4" media="(max-width: 767px)">
				</video>

				<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Circuits Guidés et sur mesure en Islande</h1>
					<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide mb-8">
						Découvrez l'Islande à travers nos circuits sur plusieurs jours entièrement personnalisés.
					</p>
					<a href="#custom-tour-form" class="contact-cta-button inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-white no-underline border border-white rounded-sm font-light text-sm transition-all duration-300 flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:translate-x-px cursor-pointer">
						Demander un voyage sur mesure
					</a>
				</div>
			</header>
		<main>
			<section class="fade-in bg-white py-32">
				<div class="max-w-7xl w-full mx-auto px-8">
					<div class="text-center mb-16 max-w-4xl mx-auto slide-up">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Nos Circuits sur mesure en Islande sur plusieurs Jours</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide mb-8">
							Tous nos circuits sont entièrement personnalisés sur mesure.
						</p>
					</div>

					<div class="tours-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 slide-up">
						{allMultidayTours.map((tour) => (
							<MultidayItineraryCard
								image={tour.data.cardImg.srcPC || "/images/fallback-tour.jpg"}
								imageAlt={tour.data.cardImg.alt || tour.data.title}
								title={tour.data.title}
								duration={tour.data.duration || "Duration TBD"}
								description={tour.data.cardSentence || "Discover Iceland's beauty"}
								price={tour.data.price ? `${tour.data.price}` : "Price on request"}
								highlights={tour.data.highlights.filter(h => h.trim() !== "")}
								season={tour.data.season || "Year Round"}
								slug={tour.slug}
								currentLang="fr"
							/>
						))}
					</div>
				</div>
			</section>

			<!-- Custom Tour Form Section -->
			<section id="custom-tour-form" class="fade-in bg-gray-50 py-32">
				<div class="max-w-4xl mx-auto px-8">
					<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-6 text-center text-gray-900 slide-down">Créez Votre Voyage Parfait</h2>
					<p class="text-center text-gray-600 mb-8 text-lg slide-up">Partagez vos rêves de voyage avec nous, et nous créerons l'aventure islandaise parfaite adaptée à vos préférences.</p>
					<p class="text-center text-gray-600 mb-12 text-lg slide-up">Vous préférez en discuter ? <a href="https://calendly.com/julien-lilja-tours/schedule-phone-meeting?month=2026-03" target="_blank" rel="noopener noreferrer" class="text-[#c49a6c] underline hover:text-[#b08a5c] transition-colors">Planifiez un appel téléphonique</a> avec nous.</p>

					<div class="bg-white p-8 rounded-sm shadow-lg slide-up">
						<form id="multiday-tour-form" class="space-y-6">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="first-name" class="block text-sm font-medium text-gray-700 mb-2">
										Prénom <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="first-name"
										name="firstName"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Votre prénom"
									/>
								</div>

								<div>
									<label for="last-name" class="block text-sm font-medium text-gray-700 mb-2">
										Nom <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="last-name"
										name="lastName"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Votre nom"
									/>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="email" class="block text-sm font-medium text-gray-700 mb-2">
										Adresse Email <span class="text-red-500">*</span>
									</label>
									<input
										type="email"
										id="email"
										name="email"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="jean@exemple.com"
									/>
								</div>

								<div>
									<label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
										Numéro de Téléphone <span class="text-red-500">*</span>
									</label>
									<input
										type="tel"
										id="phone"
										name="phone"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Veuillez inclure l'indicatif pays"
									/>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="num-people" class="block text-sm font-medium text-gray-700 mb-2">
										Nombre de Personnes <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-people"
										name="numPeople"
										required
										min="1"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder=""
									/>
								</div>

								<div>
									<label for="num-children" class="block text-sm font-medium text-gray-700 mb-2">
										Combien d'Enfants ? <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-children"
										name="numChildren"
										required
										min="0"
										value="0"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="0"
									/>
								</div>
							</div>

							<div>
								<label for="children-ages" class="block text-sm font-medium text-gray-700 mb-2">
									Quel Âge Ont les Enfants ?
								</label>
								<input
									type="text"
									id="children-ages"
									name="childrenAges"
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
									placeholder="Pour trouver des activités adaptées"
								/>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="num-days" class="block text-sm font-medium text-gray-700 mb-2">
										Combien de Jours avec Guide Privé ? <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-days"
										name="numDays"
										required
										min="1"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder=""
									/>
								</div>

								<div>
									<label for="travel-dates" class="block text-sm font-medium text-gray-700 mb-2">
										Quand Venez-vous en Islande ? <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="travel-dates"
										name="travelDates"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="ex : 15-22 juin 2025"
									/>
								</div>
							</div>

							<div>
								<label class="block text-sm font-medium text-gray-700 mb-2">
									Quels Sont Vos Centres d'Intérêt ?
								</label>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Sightseeing" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Tourisme</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Hiking" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Randonnée</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Adventure" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Aventure</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Relaxation & Hot Springs" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Détente & Sources Chaudes</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Culture" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Culture</span>
									</label>
								</div>
							</div>

							<div>
								<label for="accommodation-type" class="block text-sm font-medium text-gray-700 mb-2">
									Type d'Hébergement <span class="text-red-500">*</span>
								</label>
								<select
									id="accommodation-type"
									name="accommodationType"
									required
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
								>
									<option value="">Sélectionnez le type d'hébergement</option>
									<option value="4* hotels">Hôtels 4*</option>
									<option value="3* hotels">Hôtels 3*</option>
									<option value="Guesthouses">Maisons d'hôtes</option>
									<option value="Camping">Camping (équipement confortable fourni)</option>
									<option value="Other">Autre</option>
								</select>
							</div>

							<div>
								<label for="budget" class="block text-sm font-medium text-gray-700 mb-2">
									Budget Total pour l'Ensemble du Groupe <span class="text-red-500">*</span>
								</label>
								<p class="text-xs text-gray-500 mb-3">Il s'agit de votre budget total pour tout le voyage, pas par personne ni par jour.</p>
								<div class="grid grid-cols-2 gap-4">
									<div>
										<input
											type="number"
											id="budget"
											name="budgetAmount"
											required
											min="1"
											class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
											placeholder="Montant"
										/>
									</div>
									<div>
										<select
											id="budget-currency"
											name="budgetCurrency"
											required
											class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										>
											<option value="">Devise</option>
											<option value="EUR">EUR (€)</option>
											<option value="USD">USD ($)</option>
											<option value="ISK">ISK (Kr)</option>
										</select>
									</div>
								</div>
								<p class="text-xs text-gray-500 mt-3 italic">Connaître votre budget nous aide à concevoir un voyage qui correspond à vos attentes. Cela nous permet de recommander les hébergements, activités et expériences adaptés sans en faire trop ou pas assez.</p>
							</div>

							<div>
								<label for="details" class="block text-sm font-medium text-gray-700 mb-2">
									Détails Supplémentaires
								</label>
								<textarea
									id="details"
									name="details"
									rows="6"
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 resize-y"
									placeholder="Parlez-nous de vos rêves de voyage, demandes spéciales ou questions. Plus vous donnez de détails, mieux nous pourrons créer votre aventure islandaise parfaite..."
								></textarea>
							</div>

							<div id="form-message" class="hidden p-4 rounded-sm"></div>

							<button
								type="submit"
								id="submit-button"
								class="w-full bg-[var(--secondary)] text-white px-8 py-4 rounded-sm font-medium tracking-wide hover:bg-[#5b7297] transition-all duration-300 transform hover:translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--secondary)] cursor-pointer"
							>
								Envoyer Ma Demande
							</button>
						</form>
					</div>
				</div>
			</section>

			<!-- Trust Bar -->
			<section class="fade-in bg-white py-10 border-b border-gray-100">
				<div class="max-w-4xl mx-auto px-8 text-center">
					<p class="text-xs font-light tracking-widest uppercase text-gray-400 mb-5">Reconnu par les meilleurs conseillers voyage</p>
					<div class="flex items-center justify-center gap-8 flex-wrap">
						<a href="https://www.smartflyer.com/" target="_blank" rel="noopener noreferrer" aria-label="SmartFlyer - Partenaire Elevate" class="inline-block transition-all duration-300 grayscale opacity-50 hover:grayscale-0 hover:opacity-100">
							<OptimizedImage
								src="/logos/SmartFlyer-Stacked-Logo-Blue.png"
								alt="SmartFlyer Partenaire Elevate"
								class="h-16 md:h-20 w-auto block"
								sizes="100px"
								widths={[100, 200]}
								loading="lazy"
							/>
						</a>
					</div>
				</div>
			</section>
		</main>

		<Footer currentLang="fr" />

		<script src="/js/multiday-tours.js" defer></script>
	</body>
</html>
