---
import "../../styles/global.css"
import Topbar from "../../components/Topbar.astro"
import Footer from "../../components/Footer.astro"
import OptimizedImage from "../../components/OptimizedImage.astro"
import { getOgImageUrl } from "../../utils/images"

// Generate optimized OG image URL
const ogImageUrl = getOgImageUrl("/pictures/index/about.jpg");
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Découvrez Lilja Tours - opérateur de circuits privés premium en Islande. Guides locaux experts, véhicules haut de gamme et aventures personnalisées à travers les paysages spectaculaires d'Islande depuis 2021.">
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/about/" />
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/about/" />
		<link rel="canonical" href="https://www.lilja-tours.com/fr/about/" />

		<meta property="og:title" content="À Propos - Circuits Privés en Islande | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:url" content="https://www.lilja-tours.com/fr/about/">
		<meta property="og:description" content="Découvrez Lilja Tours - opérateur de circuits privés premium en Islande. Guides locaux experts, véhicules haut de gamme et aventures personnalisées à travers les paysages spectaculaires d'Islande depuis 2021.">

		<meta property="og:locale" content="fr_FR">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>À Propos - Circuits Privés en Islande | Lilja Tours</title>

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			// Set linker before the config command
			gtag('set', 'linker', {
				'domains': ['bokun.io']
			});

			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "AboutPage",
			"mainEntity": {
				"@type": "LocalBusiness",
				"@id": "https://www.lilja-tours.com",
				"name": "Lilja Tours",
				"description": "Premier private tour operator in Iceland specializing in personalized day tours and customized multi-day adventures. Expert local guides providing luxury travel experiences across Iceland's stunning landscapes since 2021.",
				"url": "https://www.lilja-tours.com",
				"foundingDate": "2021",
				"telephone": "+354-764-3715",
				"email": "info@lilja-tours.com",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Iceland",
					"addressCountry": "IS"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": "64.9631",
					"longitude": "-19.0208"
				},
				"priceRange": "€€€",
				"sameAs": [
					"https://www.facebook.com/liljatours",
					"https://www.instagram.com/lilja_tours",
					"https://www.tripadvisor.com/Attraction_Review-g189970-d23867059-Reviews-Lilja_Tours-Reykjavik_Capital_Region.html"
				],
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "5.0",
					"reviewCount": "50",
					"bestRating": "5",
					"worstRating": "1"
				},
				"founder": {
					"@type": "Person",
					"name": "Julien",
					"jobTitle": "Founder & Travel Designer"
				},
				"employee": [
					{
						"@type": "Person",
						"name": "Julien",
						"jobTitle": "Founder & Travel Designer"
					},
					{
						"@type": "Person",
						"name": "Philippe",
						"jobTitle": "Co-owner & Lead Guide"
					}
				]
			}
		}
		</script>

		<style is:inline>
			/* Minimal CSS for features not available in Tailwind */
			.fade-in {
				opacity: 0;
				transition: opacity 0.8s ease-out;
			}

			.fade-in.visible {
				opacity: 1;
			}

			.slide-up {
				opacity: 0;
				transform: translateY(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-up.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-down {
				opacity: 0;
				transform: translateY(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-down.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-left {
				opacity: 0;
				transform: translateX(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-left.visible {
				opacity: 1;
				transform: translateX(0);
			}

			.slide-right {
				opacity: 0;
				transform: translateX(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-right.visible {
				opacity: 1;
				transform: translateX(0);
			}

			/* Header background image styles */
			.image-header {
				position: relative;
				overflow: hidden;
				background-image: url('/pictures/index/about-page.jpg');
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
			}

			.image-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.5);
				z-index: 1;
			}

			.image-content {
				position: relative;
				z-index: 2;
			}

			/* Team contact button styles */
			.team-contact-item::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: #5b7297;
				transform: translateY(-100%);
				transition: transform 0.8s ease;
				z-index: -1;
			}

			.team-contact-item:hover::before {
				transform: translateY(0);
			}

			/* Mobile responsive adjustments for background */
			@media (max-width: 768px) {
				.image-header {
					background-attachment: scroll;
				}
			}
		</style>
	</head>
	<body>
		<!-- Image Header Section -->
		<header class="image-header h-[75dvh] flex items-center justify-center relative">
			<Topbar englishUrl="/about/" currentLang="fr" />
			<div class="image-overlay"></div>
			<div class="image-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
				<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">À Propos de Lilja Tours</h1>
				<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide">
					Créateur d'aventures islandaises inoubliables depuis 2021. Guides locaux, véhicules de luxe et expériences sur mesure à travers les paysages magiques de l'Islande.
				</p>
			</div>
		</header>

		<main>
			<!-- Our Story Section -->
			<section class="fade-in bg-white py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="flex flex-col lg:grid lg:grid-cols-2 gap-16 items-center">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide leading-tight text-gray-900 lg:hidden order-1 text-left w-full">Notre Histoire</h2>
						<div class="slide-left relative order-2 lg:order-2 w-full">
							<OptimizedImage
								src="/pictures/index/about-story.jpg"
								alt="Paysage islandais mettant en valeur la beauté naturelle"
								class="w-full h-[500px] object-cover object-center rounded-sm shadow-2xl transition-transform duration-300 hover:scale-105"
								sizes="(max-width: 1024px) 100vw, 50vw"
								loading="eager"
							/>
						</div>
						<div class="slide-right text-left order-3 lg:order-1">
							<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide mb-10 leading-tight text-gray-900 lg:block hidden">Notre Histoire</h2>
							<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-black mb-6 tracking-wide">
								Fondée en 2021, Lilja Tours est née d'une passion d'un guide pour la beauté extraordinaire de l'Islande. Ce qui a commencé comme une vision de concevoir des circuits privés d'exception est devenu l'art de créer des voyages inoubliables à travers la terre de feu et de glace.
							</p>
							<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-black mb-6 tracking-wide">
								Notre approche est simple mais distinctive : nous croyons que chaque voyageur mérite une expérience sur mesure qui reflète ses intérêts uniques, son rythme et sa curiosité. Nous concevons chaque circuit pour qu'il soit aussi individuel que vous l'êtes.
							</p>
							<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-black mb-0 tracking-wide">
								Basée en Islande et opérée par des locaux passionnés et installés sur place, nous combinons la connaissance du terrain avec une hospitalité authentique. Notre engagement envers l'excellence, la sécurité et le respect de la nature garantit que chaque voyage avec Lilja Tours devient un souvenir précieux tout en respectant l'environnement fragile de l'Islande.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Meet Our Team Section -->
			<section class="fade-in bg-gray-50 py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="text-center mb-24 slide-down">
						<h2 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Rencontrez Notre Équipe</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide max-w-3xl mx-auto">
							Les guides passionnés et concepteurs de voyages derrière votre aventure islandaise. Avec des années d'expérience et une connaissance locale approfondie, nous sommes dédiés à la création de voyages exceptionnels.
						</p>
					</div>

					<div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-stretch">
						<div class="text-center bg-white p-12 rounded-sm shadow-2xl transition-transform duration-300 hover:-translate-y-2.5 hover:shadow-3xl flex flex-col h-full slide-up">
							<OptimizedImage
								src="/pictures/index/julien-guide.jpg"
								alt="Julien, Fondateur et Concepteur de Voyages chez Lilja Tours"
								class="w-50 h-50 rounded-full object-cover object-center mx-auto mb-8 block border-4 border-gray-100 transition-transform duration-300 group-hover:scale-105"
								sizes="200px"
								widths={[200, 400]}
							/>
							<h3 class="text-3xl md:text-4xl font-normal tracking-wide mb-2 text-gray-900">Julien</h3>
							<p class="text-base md:text-lg font-light tracking-wider uppercase text-[#5b7297] mb-8">Fondateur & Concepteur de Voyages</p>
							<p class="text-sm md:text-base lg:text-lg font-light leading-relaxed text-gray-600 mb-10 tracking-wide flex-grow flex items-center">
								La passion de Julien pour l'Islande a commencé des années avant la fondation de Lilja Tours, à travers d'innombrables voyages dans tous les coins du pays. Il se concentre sur la conception de voyages personnalisés, convaincu que les meilleures aventures émergent lorsque les itinéraires sont façonnés autour des intérêts individuels plutôt que des modèles fixes. Maîtrisant l'anglais et le français, Julien excelle dans la compréhension des préférences de voyage, transformant les idées en expériences orchestrées qui équilibrent les attractions célèbres de l'Islande avec des découvertes hors des sentiers battus adaptées à la curiosité de chaque voyageur.
							</p>
							<div class="flex flex-col gap-2 items-center mt-auto">
								<a href="https://wa.me/3547643715" class="inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline rounded-sm font-light text-xs sm:text-sm transition-all duration-300 flex-shrink-0 tracking-wide relative overflow-hidden hover:text-white hover:translate-x-px team-contact-item" target="_blank" rel="noopener noreferrer">
									<svg class="w-4.5 h-4.5 fill-current transition-colors duration-300" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.384 3.697"/>
									</svg>
									+354 764 3715
								</a>
								<a href="mailto:julien@lilja-tours.com" class="inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline rounded-sm font-light text-xs sm:text-sm transition-all duration-300 flex-shrink-0 tracking-wide relative overflow-hidden hover:text-white hover:translate-x-px team-contact-item">
									<svg class="w-4.5 h-4.5 fill-current transition-colors duration-300" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
									</svg>
									julien@lilja-tours.com
								</a>
							</div>
						</div>

						<div class="text-center bg-white p-12 rounded-sm shadow-2xl transition-transform duration-300 hover:-translate-y-2.5 hover:shadow-3xl flex flex-col h-full slide-up">
							<OptimizedImage
								src="/pictures/index/philippe-guide.jpg"
								alt="Philippe, Co-propriétaire et Guide Principal chez Lilja Tours"
								class="w-50 h-50 rounded-full object-cover object-center mx-auto mb-8 block border-4 border-gray-100 transition-transform duration-300 group-hover:scale-105"
								sizes="200px"
								widths={[200, 400]}
							/>
							<h3 class="text-3xl md:text-4xl font-normal tracking-wide mb-2 text-gray-900">Philippe</h3>
							<p class="text-base md:text-lg font-light tracking-wider uppercase text-[#5b7297] mb-8">Co-propriétaire & Guide Principal</p>
							<p class="text-sm md:text-base lg:text-lg font-light leading-relaxed text-gray-600 mb-10 tracking-wide flex-grow flex items-center">
								Philippe apporte un grand enthousiasme à chaque circuit, combinant la maîtrise technique des terrains islandais avec un don inné pour la narration. Son style de guidage met l'accent sur la connexion, qu'il s'agisse de partager des aperçus géologiques à des points de vue spectaculaires ou de révéler le folklore local qui donne vie aux paysages. Au-delà de ses compétences de conduite sur les routes pavées et les hautes terres accidentées, la plus grande force de Philippe réside dans sa capacité à lire l'énergie de chaque groupe et à adapter les circuits spontanément, garantissant que chaque moment semble naturel et parfaitement adapté aux besoins de ses invités.
							</p>
							<div class="flex flex-col gap-2 items-center mt-auto">
								<a href="https://wa.me/3547728756" class="inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline rounded-sm font-light text-xs sm:text-sm transition-all duration-300 flex-shrink-0 tracking-wide relative overflow-hidden hover:text-white hover:translate-x-px team-contact-item" target="_blank" rel="noopener noreferrer">
									<svg class="w-4.5 h-4.5 fill-current transition-colors duration-300" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893A11.821 11.821 0 0020.384 3.697"/>
									</svg>
									+354 772 8756
								</a>
								<a href="mailto:philippe@lilja-tours.com" class="inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline rounded-sm font-light text-xs sm:text-sm transition-all duration-300 flex-shrink-0 tracking-wide relative overflow-hidden hover:text-white hover:translate-x-px team-contact-item">
									<svg class="w-4.5 h-4.5 fill-current transition-colors duration-300" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
									</svg>
									philippe@lilja-tours.com
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Our Fleet Section -->
			<section class="fade-in bg-white py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="text-center mb-16 slide-down">
						<h2 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Notre Flotte</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide max-w-3xl mx-auto">
							Voyagez dans le confort et le style avec nos véhicules premium méticuleusement entretenus. Des routes pavées aux pistes des hautes terres les plus difficiles, nous avons le véhicule parfait pour chaque aventure.
						</p>
					</div>

					<!-- Mercedes V-Class -->
					<div class="mb-20 slide-up">
						<div class="bg-gray-50 rounded-sm shadow-xl overflow-hidden">
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
								<div class="relative h-[350px] lg:h-auto">
									<OptimizedImage
										src="/pictures/index/about-vclass.jpg"
										alt="Van de luxe Mercedes V-Class pour les circuits en Islande"
										class="w-full h-full object-cover"
										sizes="(max-width: 1024px) 100vw, 50vw"
									/>
								</div>
								<div class="p-8 md:p-12 flex flex-col justify-center">
									<h3 class="text-3xl md:text-4xl font-light tracking-wide mb-4 text-gray-900">Mercedes V-Class</h3>
									<p class="text-base md:text-lg font-light leading-relaxed text-gray-600 mb-6 tracking-wide">
										Notre Mercedes V-Class premium est le véhicule pour les voyages de luxe sur les routes pavées d'Islande. Conçu pour le confort lors de trajets prolongés, ce van dispose de sièges en cuir spacieux pour jusqu'à 6 passagers, de fenêtres panoramiques offrant des vues époustouflantes sur les paysages islandais, et d'un intérieur raffiné qui transforme le temps de trajet en moment de détente.
									</p>
									<div class="space-y-3">
										<div class="flex items-center gap-3">
											<div class="w-2 h-2 bg-[#5b7297] rounded-full"></div>
