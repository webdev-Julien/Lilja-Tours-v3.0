---
import "../../styles/global.css"
import Topbar from "../../components/Topbar.astro"
import Footer from "../../components/Footer.astro"
import { getOgImageUrl, getBackgroundImageUrl } from '../../utils/images';

const ogImage = getOgImageUrl('/pictures/index/contact.webp');
const headerBgImage = getBackgroundImageUrl('/pictures/index/contact.webp', 1920);
---

<html lang="fr">
	<head>
