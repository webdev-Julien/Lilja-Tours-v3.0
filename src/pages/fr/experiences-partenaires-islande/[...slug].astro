---
import "../../../styles/global.css"
import { getCollection } from 'astro:content';
import Footer from "../../../components/Footer.astro";
import Topbar from "../../../components/Topbar.astro";
import ExperienceCard from "../../../components/ExperienceCard.astro";
import OptimizedImage from "../../../components/OptimizedImage.astro";
import { getOgImageUrl, getJsonLdImages } from "../../../utils/images";

export async function getStaticPaths() {
  const experiences = await getCollection('partner_experiences_FR');
  return experiences.map((experience) => ({
    params: { slug: experience.data.slug || experience.slug },
    props: { experience },
  }));
}

const { experience } = Astro.props;
const { Content } = await experience.render();
const data = experience.data;

// Get 3 random other experiences from the same collection (random at build time)
const allExperiences = await getCollection('partner_experiences_FR');
const otherExperiences = allExperiences.filter(e => e.id !== experience.id);
// Fisher-Yates shuffle for random selection at build time
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}
const randomExperiences = shuffleArray(otherExperiences).slice(0, 3);

// Fetch currency conversion rates
let exchangeRates = { USD: 0.0073, EUR: 0.0067 }; // Fallback rates
try {
  const response = await fetch('https://api.frankfurter.app/latest?from=ISK&to=USD,EUR');
  if (response.ok) {
    const currencyData = await response.json();
    exchangeRates = currencyData.rates;
  }
} catch (error) {
  console.log('Currency API unavailable, using fallback rates');
}

// Generate optimized image URLs
const ogImagePath = data.featuredImage || data.headerImage?.srcPC;
const ogImage = ogImagePath ? getOgImageUrl(ogImagePath) : null;

// Transform JSON-LD images for production
const transformedJsonLD = { ...data.jsonLD };
if (transformedJsonLD.image) {
  const originalImage = Array.isArray(transformedJsonLD.image) ? transformedJsonLD.image[0] : transformedJsonLD.image;
  const imagePath = originalImage.replace('https://www.lilja-tours.com', '');
  transformedJsonLD.image = getJsonLdImages(imagePath);
}
---

<html lang={data.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={data.metaDescription} />

    <link rel="canonical" href={data.canonicalUrl} />
    {data.hreflangAlternates && data.hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    <meta property="og:title" content={data.pageTitle} />
    <meta property="og:type" content="website" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta property="og:url" content={data.canonicalUrl} />
    <meta property="og:description" content={data.metaDescription} />

    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="generator" content={Astro.generator} />
    <title>{data.pageTitle}</title>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
    <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-48C94854K2');</script>

    <!-- GDPR Cookie Consent -->
    <link rel="stylesheet" href="/css/gdpr-consent.css" />
    <script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

    <!-- TrustIndex Rich Snippet -->
    <script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

    <script type="application/ld+json" set:html={JSON.stringify(transformedJsonLD)} />

    <style is:inline>
      /* Scroll Animation Classes */
      .fade-in {
        opacity: 0;
        transition: opacity 0.8s ease-out;
      }

      .fade-in.visible {
        opacity: 1;
      }

      .slide-up {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-up.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .slide-down {
        opacity: 0;
        transform: translateY(-50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-down.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .slide-left {
        opacity: 0;
        transform: translateX(50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-left.visible {
        opacity: 1;
        transform: translateX(0);
      }

      .slide-right {
        opacity: 0;
        transform: translateX(-50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-right.visible {
        opacity: 1;
        transform: translateX(0);
      }

      /* Mobile responsive adjustments */
      @media (max-width: 768px) {
        .bg-fixed {
          background-attachment: scroll;
        }
      }

      /* Booking Button Hover Effects */
      .booking-cta-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #5b7297;
        transform: translateY(-100%);
        transition: transform 0.8s ease;
        z-index: -1;
      }

      .booking-cta-button:hover::before {
        transform: translateY(0);
      }

      /* Gallery Carousel */
      .gallery-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .gallery-track {
        display: flex;
        width: fit-content;
        gap: 1.5rem;
        animation: scroll-left 225s linear infinite;
      }

      .gallery-track:hover {
        animation-play-state: paused;
      }

      .gallery-slide-group {
        display: flex;
        gap: 1.5rem;
        flex-shrink: 0;
      }

      .gallery-item {
        flex-shrink: 0;
        width: 375px;
        height: 375px;
      }

      @keyframes scroll-left {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(calc(-100% - 1.5rem));
        }
      }

      /* Responsive Gallery */
      @media (max-width: 1023px) {
        .gallery-container {
          gap: 1rem;
        }

        .gallery-track {
          gap: 1rem;
          animation: scroll-left 50s linear infinite;
        }

        .gallery-slide-group {
          gap: 1rem;
        }

        .gallery-item {
          width: 312px;
          height: 312px;
        }

        @keyframes scroll-left {
          0% {
            transform: translateX(0);
          }
          100% {
            transform: translateX(calc(-100% - 1rem));
          }
        }
      }

      @media (max-width: 767px) {
        .gallery-item {
          width: 250px;
          height: 250px;
        }

        .gallery-track {
          animation: scroll-left 100s linear infinite;
        }
      }

      /* Experience Content Styling */
      .experience-content {
        color: #374151;
        line-height: 1.8;
      }

      .experience-content h2 {
        color: #1f2937;
        font-size: 2rem;
        font-weight: 300;
        letter-spacing: 0.025em;
        margin-top: 3rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #e5e7eb;
        position: relative;
      }

      .experience-content h2:first-of-type {
        margin-top: 0;
      }

      .experience-content h2::before {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 60px;
        height: 2px;
        background: var(--secondary);
      }

      .experience-content h3 {
        color: #374151;
        font-size: 1.5rem;
        font-weight: 400;
        letter-spacing: 0.025em;
        margin-top: 2rem;
        margin-bottom: 1rem;
      }

      .experience-content p {
        margin-bottom: 1.5rem;
        text-align: justify;
        hyphens: auto;
      }

      .experience-content p:last-child {
        margin-bottom: 0;
      }

      .experience-content strong {
        color: #1f2937;
        font-weight: 600;
      }

      .experience-content ul,
      .experience-content ol {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
      }

      .experience-content li {
        margin-bottom: 0.75rem;
        padding-left: 0.5rem;
      }

      .experience-content li::marker {
        color: var(--secondary);
      }

      /* Responsive adjustments */
      @media (max-width: 768px) {
        .experience-content h2 {
          font-size: 1.75rem;
          margin-top: 2rem;
        }

        .experience-content h3 {
          font-size: 1.375rem;
        }

        .experience-content p {
          text-align: left;
          hyphens: none;
        }
      }
    </style>
  </head>

  <body>
    <Topbar currentLang={data.language} englishUrl={data.urlOtherLang} />

    <!-- Header Section with Background Image -->
    <header class="relative w-full h-[65dvh] overflow-hidden">
      {data.headerImage && (
        <div class="absolute inset-0 w-full h-full">
          <OptimizedImage
            src={data.headerImage.srcPC}
            alt={data.headerImage.alt || ''}
            class="w-full h-full object-cover object-center"
            sizes="100vw"
            loading="eager"
          />
        </div>
      )}

      <!-- Dark overlay for better text readability -->
      <div class="absolute inset-0 bg-black/20 z-10"></div>

      <!-- Header content -->
      <div class="relative z-20 h-full flex items-center justify-center">
        <div class="max-w-4xl mx-auto px-8 text-center text-white">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide mb-6 leading-tight slide-down">
            {data.title}
          </h1>
          <p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed tracking-wide opacity-95 slide-up" set:html={data.introductoryText}>
          </p>
          <a
            href={data.bookingLink}
            target="_blank"
            rel="noopener noreferrer"
            class="header-booking-cta inline-block mt-8 px-10 py-4 bg-white/10 backdrop-blur-sm text-white border border-white/50 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:bg-white hover:text-gray-900 hover:border-white slide-up"
          >
            Réserver
          </a>
        </div>
      </div>
    </header>

    <main class="bg-white">
      <!-- Experience Information Section -->
      <section class="fade-in py-16 lg:py-24">
        <div class="max-w-6xl mx-auto px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <!-- Experience Details -->
            <div class="slide-right">
              <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-8 text-gray-900">Détails de l'Expérience</h2>

              <div class="space-y-6 mb-8">
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Durée :</span>
                  </div>
                  <span class="text-gray-900">{data.duration}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2 2v0zM3 7a2 2 0 012-2h14a2 2 0 012 2v0M8 2v4m8-4v4"/>
                    </svg>
                    <span class="font-medium text-gray-600">Saison :</span>
                  </div>
                  <span class="text-gray-900">{data.season}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Lieu :</span>
                  </div>
                  <span class="text-gray-900">{data.location}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Difficulté :</span>
                  </div>
                  <span class="text-gray-900">{data.difficultyLevel}</span>
                </div>
              </div>

            </div>

            <!-- Highlights -->
            {data.highlights && data.highlights.length > 0 && (
              <div class="slide-left">
                <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-8 text-gray-900">Points Forts</h2>
                <ul class="space-y-4">
                  {data.highlights.map((highlight) => (
                    <li class="flex items-start">
                      <svg class="w-5 h-5 text-[var(--secondary)] mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
      <!-- Booking Section -->
      <section class="fade-in bg-white py-16 lg:py-24">
        <div class="max-w-4xl mx-auto px-8">
          <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Réserver Cette Expérience</h2>
                    <p class="text-center text-gray-600 mb-8">Ces expériences sont opérées par nos partenaires et généralement guidées en anglais. Pour un accompagnement en français, découvrez nos <a href="/fr/circuits-prives-islande/" class="text-[var(--secondary)] hover:underline">excursions privées</a>.</p>

          <div class="bg-gray-50 p-8 rounded-sm shadow-lg hover:shadow-xl transition-shadow duration-300 slide-up">
            <div class="text-center mb-8">
              <div class="text-3xl font-light text-gray-900 mb-2">{data.price.toLocaleString()} ISK</div>
              <div class="text-sm text-gray-500 space-x-4">
                <span>≈ ${Math.round(data.price * exchangeRates.USD).toLocaleString()} USD</span>
                <span>≈ €{Math.round(data.price * exchangeRates.EUR).toLocaleString()} EUR</span>
              </div>
            </div>

            <a
              href={data.bookingLink}
              class="booking-cta-button block w-full text-center bg-transparent text-[var(--secondary)] border border-[var(--secondary)] px-8 py-4 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:text-white hover:translate-y-0.5"
            >
              Réserver Cette Expérience
            </a>
          </div>
        </div>
      </section>
      <!-- Gallery Section -->
      {data.gallery && data.gallery.length > 0 && (
        <section class="fade-in bg-gray-50 py-16 lg:py-24 overflow-hidden">
          <div class="max-w-7xl mx-auto px-8">
            <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Galerie</h2>

            <!-- Infinite Scroll Gallery -->
            <div class="gallery-container">
              <div class="gallery-track">
                <div class="gallery-slide-group">
                  {data.gallery.map((image, index) => (
                    <div class="gallery-item">
                      <div class="block aspect-square overflow-hidden rounded-sm">
                        <OptimizedImage
                          src={image.srcPC}
                          alt={image.alt || ''}
                          class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
                          sizes="(max-width: 767px) 250px, (max-width: 1023px) 312px, 375px"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  ))}
                </div>
                <!-- Duplicate for seamless loop -->
                <div class="gallery-slide-group">
                  {data.gallery.map((image, index) => (
                    <div class="gallery-item">
                      <div class="block aspect-square overflow-hidden rounded-sm">
                        <OptimizedImage
                          src={image.srcPC}
                          alt={image.alt || ''}
                          class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
                          sizes="(max-width: 767px) 250px, (max-width: 1023px) 312px, 375px"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      )}



      <!-- Content from MDX -->
      <section class="fade-in py-16 lg:py-24 bg-gray-50">
        <div class="max-w-6xl mx-auto px-8 prose prose-lg experience-content">
          <Content />
        </div>
      </section>
           <section class="fade-in bg-white py-16 lg:py-24">
        <div class="max-w-4xl mx-auto px-8">
          <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Réserver Cette Expérience</h2>
          <p class="text-center text-gray-600 mb-8">Ces expériences sont opérées par nos partenaires et généralement guidées en anglais. Pour un accompagnement en français, découvrez nos <a href="/fr/circuits-prives-islande/" class="text-[var(--secondary)] hover:underline">excursions privées</a>.</p>

          <div class="bg-gray-50 p-8 rounded-sm shadow-lg hover:shadow-xl transition-shadow duration-300 slide-up">
            <div class="text-center mb-8">
              <div class="text-3xl font-light text-gray-900 mb-2">{data.price.toLocaleString()} ISK</div>
              <div class="text-sm text-gray-500 space-x-4">
                <span>≈ ${Math.round(data.price * exchangeRates.USD).toLocaleString()} USD</span>
                <span>≈ €{Math.round(data.price * exchangeRates.EUR).toLocaleString()} EUR</span>
              </div>
            </div>

            <a
              href={data.bookingLink}
              class="booking-cta-button block w-full text-center bg-transparent text-[var(--secondary)] border border-[var(--secondary)] px-8 py-4 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:text-white hover:translate-y-0.5"
            >
              Réserver Cette Expérience
            </a>
          </div>
        </div>
      </section>

      <!-- Related Experiences Section -->
      {randomExperiences.length > 0 && (
        <section class="fade-in bg-gray-50 py-16 lg:py-24">
          <div class="max-w-7xl mx-auto px-8">
            <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Découvrir Plus d'Expériences</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center items-stretch">
              {randomExperiences.map((relatedExp) => (
                <ExperienceCard
                  image={relatedExp.data.cardImg?.srcPC || relatedExp.data.featuredImage}
                  imageAlt={relatedExp.data.cardImg?.alt || relatedExp.data.title}
                  title={relatedExp.data.title}
                  duration={relatedExp.data.duration}
                  description={relatedExp.data.shortDescription}
                  price={relatedExp.data.price}
                  slug={`/fr/experiences-partenaires-islande/${relatedExp.data.slug || relatedExp.slug}/`}
                  location={relatedExp.data.location}
                  difficulty={relatedExp.data.difficultyLevel}
                  season={relatedExp.data.season}
                  isExclusive={relatedExp.data.isExclusive}
                />
              ))}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer currentLang={data.language} />

    <script>
      // Intersection Observer for scroll animations
      function initScrollAnimations() {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, observerOptions);

        const animatedElements = document.querySelectorAll(
          '.fade-in, .slide-up, .slide-down, .slide-left, .slide-right'
        );

        animatedElements.forEach((element) => {
          observer.observe(element);
        });
      }

      // Initialize when DOM is loaded
      document.addEventListener('DOMContentLoaded', () => {
        initScrollAnimations();
      });
    </script>
  </body>
</html>
