			}
		}
		</script>

		<style is:inline>
			/* Minimal CSS for features not available in Tailwind */
			.fade-in {
				opacity: 0;
				transition: opacity 0.8s ease-out;
			}

			.fade-in.visible {
				opacity: 1;
			}

			.slide-up {
				opacity: 0;
				transform: translateY(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-up.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-down {
				opacity: 0;
				transform: translateY(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-down.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.slide-left {
				opacity: 0;
				transform: translateX(50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-left.visible {
				opacity: 1;
				transform: translateX(0);
			}

			.slide-right {
				opacity: 0;
				transform: translateX(-50px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}

			.slide-right.visible {
				opacity: 1;
				transform: translateX(0);
			}

			/* Header background image styles */
			.image-header {
				position: relative;
				overflow: hidden;
				background-size: cover;
				background-position: center;
				background-attachment: fixed;
			}

			.image-overlay {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: rgba(0, 0, 0, 0.55);
				z-index: 1;
			}

			.image-content {
				position: relative;
				z-index: 2;
			}

			/* CTA button styles */
			.cta-btn::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: #5b7297;
				transform: translateY(-100%);
				transition: transform 0.6s ease;
				z-index: -1;
			}

			.cta-btn:hover::before {
				transform: translateY(0);
			}

			.cta-btn:hover {
				color: white;
				border-color: #5b7297;
			}

			/* Submit button styles */
			.submit-btn::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background: #5b7297;
				transform: translateY(-100%);
				transition: transform 0.6s ease;
				z-index: -1;
			}

			.submit-btn:hover::before {
				transform: translateY(0);
			}

			/* Partnership card hover */
			.partnership-card {
				transition: transform 0.3s ease, box-shadow 0.3s ease;
			}

			.partnership-card:hover {
				transform: translateY(-8px);
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
			}

			/* Mobile responsive adjustments for background */
			@media (max-width: 768px) {
				.image-header {
					background-attachment: scroll;
				}
			}

			/* Form input focus styles */
			.form-input:focus,
			.form-textarea:focus,
			.form-select:focus {
				outline: none;
				border-color: #5b7297;
				box-shadow: 0 0 0 3px rgba(91, 114, 151, 0.1);
			}

			/* Checkbox styling */
			.form-checkbox {
				accent-color: #5b7297;
			}
		</style>
	</head>
	<body>
		<!-- Image Header Section -->
		<header class="image-header min-h-screen flex items-center justify-center relative" style={`background-image: url('${backgroundImageUrl}')`}>
			<Topbar frenchUrl="/fr/conseillers-voyage/" currentLang="en" />
			<div class="image-overlay"></div>
			<div class="image-content text-center max-w-5xl mx-auto px-8 slide-down visible mt-[70px]">
				<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Your Iceland Partner on the Ground</h1>
				<p class="text-base sm:text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide max-w-4xl mx-auto mb-12">
					Lilja Tours is a boutique Destination Management Company based in Reykjavík, specializing in fully guided, luxury private tours across Iceland. We partner with travel advisors and agencies worldwide to deliver seamless, premium Icelandic experiences to their clients.
				</p>
				<a href="#advisor-contact-form" class="cta-btn inline-flex items-center gap-2 py-3 px-8 bg-transparent text-white border border-white rounded-sm font-light text-base transition-all duration-300 tracking-wide uppercase relative overflow-hidden hover:text-white">
					Request Our Price Sheet
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
					</svg>
				</a>
			</div>
		</header>

		<main>
			<!-- Why Partner Section -->
			<section class="fade-in bg-white py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="text-center mb-16 slide-down">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide mb-8 leading-tight text-gray-900">A DMC Built for Advisors Who Demand Excellence</h2>
						<div class="max-w-4xl mx-auto">
							<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-gray-700 mb-6 tracking-wide">
								Whether you need a reliable ground operator to execute your custom itineraries or a full-service DMC to design the entire Icelandic chapter of your client's journey, Lilja Tours delivers. Every detail, from route planning to restaurant reservations, hotel bookings to glacier hikes, is handled with precision and a personal touch.
							</p>
							<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-gray-700 tracking-wide">
								We have maintained a perfect 5-star rating across every review platform for over four years. That track record isn't a marketing claim — it's a promise your clients will experience firsthand.
							</p>
						</div>
					</div>

					<!-- Key Selling Points Grid -->
					<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 mt-16 slide-up">
						<!-- Fully Guided -->
						<div class="flex gap-6 items-start p-6 bg-gray-50 rounded-sm">
							<div class="flex-shrink-0 w-14 h-14 bg-[#5b7297]/10 rounded-sm flex items-center justify-center">
								<svg class="w-7 h-7 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl md:text-2xl font-normal tracking-wide mb-3 text-gray-900">Fully Guided, Always</h3>
								<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide">
									We do not offer self-drive tours. Every journey is led by an expert local guide in a premium vehicle, ensuring safety, comfort, and a truly immersive experience for your clients.
								</p>
							</div>
						</div>

						<!-- Premium Fleet -->
						<div class="flex gap-6 items-start p-6 bg-gray-50 rounded-sm">
							<div class="flex-shrink-0 w-14 h-14 bg-[#5b7297]/10 rounded-sm flex items-center justify-center">
								<svg class="w-7 h-7 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7h8m-8 4h8m-4-8v16M3 12h1m16 0h1M6.5 6.5L5 5m13.5 1.5L20 5M6.5 17.5L5 19m13.5-1.5L20 19"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 10h14v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7z"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl md:text-2xl font-normal tracking-wide mb-3 text-gray-900">Premium Fleet</h3>
								<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide">
									Our guests travel in Mercedes V-Class luxury vans and Toyota Land Cruiser SUVs, maintained to the highest standards for Icelandic roads and conditions.
								</p>
							</div>
						</div>

						<!-- Perfect Track Record -->
						<div class="flex gap-6 items-start p-6 bg-gray-50 rounded-sm">
							<div class="flex-shrink-0 w-14 h-14 bg-[#5b7297]/10 rounded-sm flex items-center justify-center">
								<svg class="w-7 h-7 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl md:text-2xl font-normal tracking-wide mb-3 text-gray-900">Perfect Track Record</h3>
								<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide">
									5-star rating across all platforms since 2021, with hundreds of consistently glowing reviews from guests worldwide.
								</p>
							</div>
						</div>

						<!-- Year-Round Operation -->
						<div class="flex gap-6 items-start p-6 bg-gray-50 rounded-sm">
							<div class="flex-shrink-0 w-14 h-14 bg-[#5b7297]/10 rounded-sm flex items-center justify-center">
								<svg class="w-7 h-7 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
								</svg>
							</div>
							<div>
								<h3 class="text-xl md:text-2xl font-normal tracking-wide mb-3 text-gray-900">Year-Round Operation</h3>
								<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide">
									From midnight sun adventures to Northern Lights expeditions, we operate across every Icelandic season with tours tailored to what each one does best.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Partnership Models Section -->
			<section class="fade-in bg-gray-50 py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="text-center mb-16 slide-down">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide mb-8 leading-tight text-gray-900">Work with Us Your Way</h2>
						<p class="text-base md:text-lg lg:text-xl font-light leading-relaxed text-gray-700 tracking-wide max-w-3xl mx-auto">
							We understand that every agency operates differently. That's why we offer flexible collaboration models designed to fit your workflow, not the other way around.
						</p>
					</div>

					<!-- Partnership Cards -->
					<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 slide-up">
						<!-- White Label -->
						<div class="partnership-card bg-white p-8 md:p-10 rounded-sm shadow-lg flex flex-col h-full">
							<div class="w-16 h-16 bg-[#5b7297]/10 rounded-sm flex items-center justify-center mb-6">
								<svg class="w-8 h-8 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
								</svg>
							</div>
							<h3 class="text-2xl md:text-3xl font-normal tracking-wide mb-4 text-gray-900">White Label / Ground Operator</h3>
							<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide flex-grow">
								You own the client relationship. We operate behind the scenes, executing tours under your brand. Your clients enjoy a flawless experience on the ground — and you get the credit. We provide detailed operational support, daily itinerary management, and real-time communication throughout the trip.
							</p>
						</div>

						<!-- Full-Service DMC -->
						<div class="partnership-card bg-white p-8 md:p-10 rounded-sm shadow-lg flex flex-col h-full">
							<div class="w-16 h-16 bg-[#5b7297]/10 rounded-sm flex items-center justify-center mb-6">
								<svg class="w-8 h-8 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
								</svg>
							</div>
							<h3 class="text-2xl md:text-3xl font-normal tracking-wide mb-4 text-gray-900">Full-Service DMC</h3>
							<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide flex-grow">
								Let us take the lead. Share your client's dates, interests, and budget, and we'll design a bespoke Icelandic itinerary from scratch — accommodations, activities, dining, transfers, and guided touring included. We handle the complexity so you can focus on your client relationship.
							</p>
						</div>

						<!-- À La Carte -->
						<div class="partnership-card bg-white p-8 md:p-10 rounded-sm shadow-lg flex flex-col h-full">
							<div class="w-16 h-16 bg-[#5b7297]/10 rounded-sm flex items-center justify-center mb-6">
								<svg class="w-8 h-8 text-[#5b7297]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
								</svg>
							</div>
							<h3 class="text-2xl md:text-3xl font-normal tracking-wide mb-4 text-gray-900">À La Carte Services</h3>
							<p class="text-base font-light leading-relaxed text-gray-600 tracking-wide flex-grow">
								Need just a few days of guided touring within a larger itinerary you've already built? We're happy to plug in wherever you need us — whether it's a single day tour, an airport transfer in a luxury vehicle, or a multi-day guided segment.
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- What Sets Us Apart Section -->
			<section class="fade-in bg-white py-24 md:py-32">
				<div class="max-w-6xl w-full mx-auto px-8">
					<div class="flex flex-col lg:grid lg:grid-cols-2 gap-16 items-center">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide leading-tight text-gray-900 lg:hidden order-1 text-left w-full">Local Expertise, Global Standards</h2>
						<div class="slide-left relative order-2 lg:order-2 w-full">
							<OptimizedImage
								src="/pictures/index/travel-advisors-second-pic.jpg"
								alt="Lilja Tours guide with guests exploring Iceland"
								class="w-full h-[500px] object-cover object-center rounded-sm shadow-2xl transition-transform duration-300 hover:scale-[1.02]"
								sizes="(max-width: 1024px) 100vw, 50vw"
								loading="lazy"
							/>
						</div>
						<div class="slide-right text-left order-3 lg:order-1">
