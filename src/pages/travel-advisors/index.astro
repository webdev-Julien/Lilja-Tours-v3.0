---
import "../../styles/global.css"
import Topbar from "../../components/Topbar.astro"
import Footer from "../../components/Footer.astro"
import OptimizedImage from "../../components/OptimizedImage.astro"
import { getOgImageUrl, getBackgroundImageUrl } from "../../utils/images"

// Generate optimized image URLs
const ogImageUrl = getOgImageUrl("/pictures/index/travel-advisors-bg.jpg");
const backgroundImageUrl = getBackgroundImageUrl("/pictures/index/travel-advisors-bg.jpg");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Partner with Lilja Tours, Iceland's boutique luxury DMC. Fully guided private tours, white label operations, and bespoke itinerary design for travel advisors worldwide.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/travel-advisors/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/conseillers-voyage/" />
		<link rel="canonical" href="https://www.lilja-tours.com/travel-advisors/" />

		<meta property="og:title" content="Travel Advisors — Partner with Lilja Tours | Iceland DMC">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:url" content="https://www.lilja-tours.com/travel-advisors/">
		<meta property="og:description" content="Partner with Lilja Tours, Iceland's boutique luxury DMC. Fully guided private tours, white label operations, and bespoke itinerary design for travel advisors worldwide.">

		<meta property="og:locale" content="en_US">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>Travel Advisors — Partner with Lilja Tours | Iceland DMC</title>

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}

			// Set linker before the config command
			gtag('set', 'linker', {
				'domains': ['bokun.io']
			});

			gtag('js', new Date());
			gtag('config', 'G-48C94854K2');
		</script>

		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "WebPage",
			"name": "Travel Advisors — Partner with Lilja Tours | Iceland DMC",
			"description": "Partner with Lilja Tours, Iceland's boutique luxury DMC. Fully guided private tours, white label operations, and bespoke itinerary design for travel advisors worldwide.",
			"url": "https://www.lilja-tours.com/travel-advisors/",
			"mainEntity": {
				"@type": "LocalBusiness",
				"@id": "https://www.lilja-tours.com",
				"name": "Lilja Tours",
				"alternateName": "Lilja Tours Iceland DMC",
				"description": "Boutique Destination Management Company based in Reykjavík, specializing in fully guided, luxury private tours across Iceland. Partnering with travel advisors and agencies worldwide.",
				"url": "https://www.lilja-tours.com",
				"telephone": "+354-764-3715",
				"email": "info@lilja-tours.com",
				"foundingDate": "2021",
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Reykjavik",
					"addressRegion": "Capital Region",
					"addressCountry": "IS"
				},
				"geo": {
					"@type": "GeoCoordinates",
					"latitude": "64.1466",
					"longitude": "-21.9426"
				},
				"priceRange": "€€€",
				"sameAs": [
					"https://www.facebook.com/liljatours",
					"https://www.instagram.com/lilja_tours",
					"https://www.tripadvisor.com/Attraction_Review-g189970-d23867059-Reviews-Lilja_Tours-Reykjavik_Capital_Region.html"
				],
				"aggregateRating": {
					"@type": "AggregateRating",
					"ratingValue": "5.0",
					"reviewCount": "150",
					"bestRating": "5",
					"worstRating": "1"
				},
				"makesOffer": [
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "White Label / Ground Operator Services",
							"description": "Behind-the-scenes tour operation under your brand with detailed operational support and real-time communication."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "Full-Service DMC",
							"description": "Complete bespoke Icelandic itinerary design including accommodations, activities, dining, transfers, and guided touring."
						}
					},
					{
						"@type": "Offer",
						"itemOffered": {
							"@type": "Service",
							"name": "À La Carte Services",
							"description": "Flexible guided touring segments, day tours, airport transfers, and multi-day guided segments."
						}
					}
				],
				"areaServed": {
					"@type": "Country",
					"name": "Iceland"
				},
				"audience": {
					"@type": "BusinessAudience",
					"audienceType": "Travel Advisors and Travel Agencies"
				}
			},
			"breadcrumb": {
				"@type": "BreadcrumbList",
				"itemListElement": [
					{
						"@type": "ListItem",
						"position": 1,
						"name": "Home",
						"item": "https://www.lilja-tours.com/"
					},
					{
						"@type": "ListItem",
						"position": 2,
						"name": "Travel Advisors",
						"item": "https://www.lilja-tours.com/travel-advisors/"
