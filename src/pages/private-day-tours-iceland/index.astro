---
import "../../../src/styles/global.css"
import "../../styles/private-day-tours.css"
import Topbar from "../../components/Topbar.astro"
import ItineraryCard from "../../components/ItineraryCard.astro"
import Footer from "../../components/Footer.astro"
import OptimizedImage from "../../components/OptimizedImage.astro"
import { getOgImageUrl } from "../../utils/images"
import { getCollection } from 'astro:content';

// Get all tours from the collection
const allTours = await getCollection('tours_EN');

// Generate optimized OG image URL
const ogImageUrl = getOgImageUrl("/pictures/index/multiday-bg.jpg");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="max-image-preview:large">
		<meta name="description" content="Discover all our private day tours in Iceland. From iconic Golden Circle to remote highland adventures, explore Iceland's most spectacular destinations with expert local guides.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/private-day-tours-iceland/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/circuits-prives-islande/" />
		<link rel="canonical" href="https://www.lilja-tours.com/private-day-tours-iceland/" />

		<meta property="og:title" content="Private Day Tours Iceland - All Tours | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:url" content="https://www.lilja-tours.com/private-day-tours-iceland/">
		<meta property="og:description" content="Discover all our private day tours in Iceland. From iconic Golden Circle to remote highland adventures, explore Iceland's most spectacular destinations with expert local guides.">
		<meta property="og:locale" content="en_US">
		<meta property="og:locale:alternate" content="fr_FR">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:image" content={ogImageUrl}>

		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<!-- Standard Favicon -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<meta name="generator" content={Astro.generator} />
		<title>Private Day Tours in Iceland - All Tours | Lilja Tours</title>

		<!-- Resource Preloading for Performance -->
		<link rel="preload" href="/logos/topbar-logo.webp" as="image" fetchpriority="high">
		<link rel="preload" href="/videos/tours-bg.webp" as="image">
		<link rel="preconnect" href="https://www.googletagmanager.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>
	</head>
	<body>

			<!-- Video Header Section -->
			<header class="video-header h-[75dvh] flex items-center justify-center relative">
						<Topbar frenchUrl="/fr/circuits-prives-islande/" currentLang="en" />
				<!-- Responsive Video - Browser automatically selects appropriate source based on media query -->
				<video
					autoplay
					muted
					loop
					playsinline
					preload="auto"
					poster="/videos/tours-bg.webp"
					aria-label="Iceland landscape background video"
					class="video-source absolute inset-0 w-full h-full object-cover"
				>
					<!-- Desktop HD Video (1024px and above) -->
					<source src="/videos/HD/tours-bg-hd.mp4" type="video/mp4" media="(min-width: 1024px)">

					<!-- Tablet Medium Video (768px to 1023px) -->
					<source src="/videos/MD/tours-bg-medium.mp4" type="video/mp4" media="(min-width: 768px) and (max-width: 1023px)">

					<!-- Mobile Vertical Video (0px to 767px) -->
					<source src="/videos/SD/tours-bg-mobile.mp4" type="video/mp4" media="(max-width: 767px)">
				</video>

				<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Private Day Tours in Iceland</h1>
					<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide">
						Discover Iceland's most spectacular destinations with our private day tours. From iconic landmarks to hidden gems, each journey showcases the raw beauty that makes Iceland unique.
					</p>
				</div>
			</header>
		<main>


			<!-- Tours Grid Section -->
			<section class="fade-in visible bg-white py-32">
				<div class="max-w-7xl w-full mx-auto px-8">
					<div class="text-center mb-16 max-w-4xl mx-auto slide-up visible">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Our ready-to-book day tours</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide mb-8">
							Choose from our complete collection of private day tours, each offering unique perspectives on Iceland's diverse landscapes and natural wonders.
						</p>
						<p class="text-base md:text-lg font-light leading-relaxed text-gray-500 tracking-wide mb-8">
							All our tours are fully customizable to match your interests, preferences, and schedule. From adjusting itineraries to adding special experiences, we tailor every journey to create your perfect Icelandic adventure.
						</p>
						<a href="/contact/" class="contact-cta-button inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-[#5b7297] no-underline border border-[#5b7297] rounded-sm font-light text-sm transition-all duration-300 flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:text-white hover:translate-x-px">
							Contact us for customization
						</a>
					</div>

					<div class="tours-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 slide-up visible">
						{allTours.map((tour) => (
							<ItineraryCard
								image={tour.data.cardImg.srcPC || "/images/fallback-tour.jpg"}
								imageAlt={tour.data.cardImg.alt || tour.data.title}
								title={tour.data.title}
								duration={tour.data.duration || "Duration TBD"}
								description={tour.data.cardSentence || "Discover Iceland's beauty"}
								price={tour.data.price ? `From ${tour.data.price}` : "Price on request"}
								highlights={tour.data.highlights.filter(h => h.trim() !== "")}
								season={tour.data.season || "Year Round"}
								slug={tour.data.url || `/private-day-tours-iceland/${tour.slug}`}
							/>
						))}
					</div>
				</div>
			</section>
		</main>

		<Footer currentLang="en" />

		<script>
			// Intersection Observer for scroll animations
			function initScrollAnimations() {
				const observerOptions = {
					threshold: 0.1,
					rootMargin: '0px 0px -50px 0px'
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('visible');
						}
					});
				}, observerOptions);

				const animatedElements = document.querySelectorAll(
					'.fade-in, .slide-up, .slide-down'
				);

				animatedElements.forEach((element) => {
					observer.observe(element);
				});
			}

			// Initialize animations when DOM is loaded
			document.addEventListener('DOMContentLoaded', () => {
				initScrollAnimations();
			});
		</script>
	</body>
</html>
