---
import "../../styles/global.css"
import { getCollection } from 'astro:content';
import Footer from "../../components/Footer.astro";
import Topbar from "../../components/Topbar.astro";
import ItineraryCard from "../../components/ItineraryCard.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import { getOgImageUrl, getJsonLdImages } from "../../utils/images";

export async function getStaticPaths() {
  const tours = await getCollection('tours_EN');
  return tours.map((tour) => ({
    params: { slug: tour.data.slug || tour.slug },
    props: { tour },
  }));
}

const { tour } = Astro.props;
const { Content } = await tour.render();
const data = tour.data;

// Get 3 random other tours from the same collection (random at build time)
const allTours = await getCollection('tours_EN');
const otherTours = allTours.filter(t => t.id !== tour.id);
// Fisher-Yates shuffle for random selection at build time
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}
const randomTours = shuffleArray(otherTours).slice(0, 3);

// Fetch currency conversion rates
let exchangeRates = { USD: 0.0073, EUR: 0.0067 }; // Fallback rates
try {
  const response = await fetch('https://api.frankfurter.app/latest?from=ISK&to=USD,EUR');
  if (response.ok) {
    const currencyData = await response.json();
    exchangeRates = currencyData.rates;
  }
} catch (error) {
  console.log('Currency API unavailable, using fallback rates');
}

// Generate optimized image URLs
const ogImagePath = data.featuredImage || data.headerImage?.srcPC;
const ogImage = ogImagePath ? getOgImageUrl(ogImagePath) : null;

// Transform JSON-LD images for production
const transformedJsonLD = { ...data.jsonLD };
if (transformedJsonLD.image) {
  const originalImage = Array.isArray(transformedJsonLD.image) ? transformedJsonLD.image[0] : transformedJsonLD.image;
  const imagePath = originalImage.replace('https://www.lilja-tours.com', '');
  transformedJsonLD.image = getJsonLdImages(imagePath);
}

// Extract nested FAQPage from TouristTrip mainEntity (if present) and remove it
// Google flags duplicate FAQPage when it appears both nested in TouristTrip and as standalone
let nestedFaqQuestions: Array<{ "@type": string; name: string; acceptedAnswer: { "@type": string; text: string } }> | null = null;
if (transformedJsonLD.mainEntity && transformedJsonLD.mainEntity["@type"] === "FAQPage") {
  nestedFaqQuestions = transformedJsonLD.mainEntity.mainEntity;
  delete transformedJsonLD.mainEntity;
}

// Product schema for tour pricing
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": data.title,
  "description": data.metaDescription,
  "image": data.featuredImage,
  "url": data.canonicalUrl,
  "brand": {
    "@type": "Brand",
    "name": "Lilja Tours"
  },
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": data.price,
    "highPrice": data.priceLandCruiser || data.price,
    "priceCurrency": "ISK",
    "availability": "https://schema.org/InStock",
    "offerCount": (data.priceMercedes ? 1 : 0) + (data.priceLandCruiser ? 1 : 0) + (data.bookingLinkMeetOnLocation ? 1 : 0) || 1,
    "url": data.canonicalUrl
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "150",
    "bestRating": "5",
    "worstRating": "1"
  },
  "category": "Private Tour"
};

// FAQ schema: prefer explicit faqSchema field, fall back to extracted nested FAQ from TouristTrip
const faqSchema = data.faqSchema ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faqSchema.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : nestedFaqQuestions ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": nestedFaqQuestions
} : null;
---

<html lang={data.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large">
    <meta name="description" content={data.metaDescription} />

    <link rel="canonical" href={data.canonicalUrl} />
    {data.hreflangAlternates && data.hreflangAlternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    <meta property="og:title" content={data.pageTitle} />
    <meta property="og:type" content="website" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta property="og:url" content={data.canonicalUrl} />
    <meta property="og:description" content={data.metaDescription} />

    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <!-- Standard Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator} />
    <title>{data.pageTitle}</title>

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

    <script type="application/ld+json" set:html={JSON.stringify(transformedJsonLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <style is:inline>
      /* Scroll Animation Classes */
      .fade-in {
        opacity: 0;
        transition: opacity 0.8s ease-out;
      }

      .fade-in.visible {
        opacity: 1;
      }

      .slide-up {
        opacity: 0;
        transform: translateY(50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-up.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .slide-down {
        opacity: 0;
        transform: translateY(-50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-down.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .slide-left {
        opacity: 0;
        transform: translateX(50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-left.visible {
        opacity: 1;
        transform: translateX(0);
      }

      .slide-right {
        opacity: 0;
        transform: translateX(-50px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
      }

      .slide-right.visible {
        opacity: 1;
        transform: translateX(0);
      }

      /* Mobile responsive adjustments */
      @media (max-width: 768px) {
        .bg-fixed {
          background-attachment: scroll;
        }
      }

      /* Responsive video container */
      .tour-video-container {
        position: relative;
        width: 100%;
      }

      .tour-video-container iframe {
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 0.375rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      }

      /* Prose styling for MDX body content */
      .tour-video-container h2 {
        font-size: 1.875rem;
        font-weight: 300;
        letter-spacing: 0.025em;
        color: #111827;
        margin-top: 3rem;
        margin-bottom: 1rem;
        line-height: 1.3;
      }

      .tour-video-container p {
        font-size: 1.125rem;
        line-height: 1.75;
        color: #374151;
        margin-bottom: 1.25rem;
      }

      .tour-video-container a {
        color: #5b7297;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.2s ease;
      }

      .tour-video-container a:hover {
        color: #111827;
      }

      .tour-video-container ul {
        list-style: disc;
        padding-left: 1.5rem;
        margin-bottom: 1.25rem;
      }

      .tour-video-container li {
        font-size: 1.125rem;
        line-height: 1.75;
        color: #374151;
        margin-bottom: 0.5rem;
      }

      .tour-video-container h2:first-child {
        margin-top: 2rem;
      }

      .tour-video-container iframe + h2 {
        margin-top: 3rem;
      }

      /* Booking Button Hover Effects */
      .booking-cta-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #5b7297;
        transform: translateY(-100%);
        transition: transform 0.8s ease;
        z-index: -1;
      }

      .booking-cta-button:hover::before {
        transform: translateY(0);
      }

      .meet-location-cta::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #374151;
        transform: translateY(-100%);
        transition: transform 0.8s ease;
        z-index: -1;
      }

      .meet-location-cta:hover::before {
        transform: translateY(0);
      }

      /* Infinite Gallery Carousel */
      .gallery-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .gallery-track {
        display: flex;
        width: fit-content;
        gap: 1.5rem;
        animation: scroll-left 225s linear infinite;
      }

      .gallery-track-reverse {
        animation: scroll-right 225s linear infinite;
      }

      .gallery-track:hover {
        animation-play-state: paused;
      }

      .gallery-slide-group {
        display: flex;
        gap: 1.5rem;
        flex-shrink: 0;
      }

      .gallery-item {
        flex-shrink: 0;
        width: 375px;
        height: 375px;
      }

      @keyframes scroll-left {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(calc(-100% - 1.5rem));
        }
      }

      @keyframes scroll-right {
        0% {
          transform: translateX(calc(-100% - 1.5rem));
        }
        100% {
          transform: translateX(0);
        }
      }

      /* Responsive Gallery */
      @media (max-width: 1023px) {
        .gallery-container {
          gap: 1rem;
        }

        .gallery-track {
          gap: 1rem;
          animation: scroll-left 50s linear infinite;
        }

        .gallery-track-reverse {
          animation: scroll-right 50s linear infinite;
        }

        .gallery-slide-group {
          gap: 1rem;
        }

        .gallery-item {
          width: 312px;
          height: 312px;
        }

        @keyframes scroll-left {
          0% {
            transform: translateX(0);
          }
          100% {
            transform: translateX(calc(-100% - 1rem));
          }
        }

        @keyframes scroll-right {
          0% {
            transform: translateX(calc(-100% - 1rem));
          }
          100% {
            transform: translateX(0);
          }
        }
      }

      @media (max-width: 767px) {
        .gallery-item {
          width: 250px;
          height: 250px;
        }

        .gallery-track {
          animation: scroll-left 100s linear infinite;
        }

        .gallery-track-reverse {
          animation: scroll-right 100s linear infinite;
        }
      }

      /* Floating Book Button */
      .floating-book-btn.show {
        opacity: 1 !important;
        visibility: visible !important;
      }

      @media (max-width: 640px) {
        .floating-book-btn {
          bottom: 1.5rem;
          right: 1.5rem;
          padding: 0.75rem 1.25rem;
          font-size: 0.875rem;
        }

        .floating-book-btn svg {
          width: 1.125rem;
          height: 1.125rem;
        }
      }
    </style>
  </head>

  <body>
    <Topbar currentLang={data.language} frenchUrl={data.urlOtherLang} />

    <!-- Header Section with Background Image -->
    <header class="relative w-full h-[65dvh] overflow-hidden">
      {data.headerImage && (
        <div class="absolute inset-0 w-full h-full">
          <OptimizedImage
            src={data.headerImage.srcPC}
            alt={data.headerImage.alt || ''}
            class="w-full h-full object-cover object-center"
            sizes="100vw"
            loading="eager"
          />
        </div>
      )}

      <!-- Dark overlay for better text readability--> 
      <div class="absolute inset-0 bg-black/20 z-10"></div>

      <!-- Header content -->
      <div class="relative z-20 h-full flex items-center justify-center">
        <div class="max-w-4xl mx-auto px-8 text-center text-white">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-wide mb-6 leading-tight slide-down visible">
            {data.title}
          </h1>
          <p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed tracking-wide opacity-95 slide-up visible mb-8" set:html={data.introductoryText}>
          </p>
          <a
            href="#booking"
            class="header-cta-button inline-flex items-center gap-2 px-8 py-4 bg-white/10 backdrop-blur-sm text-white border border-white/50 rounded-sm font-light text-sm md:text-base tracking-wide uppercase relative overflow-hidden transition-all duration-300 hover:bg-white hover:text-gray-900 hover:border-white slide-up visible"
          >
            Book This Tour
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main class="bg-white">
      <!-- Tour Information Section -->
      <section class="fade-in py-16 lg:py-24">
        <div class="max-w-6xl mx-auto px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <!-- Tour Details -->
            <div class="slide-right">
              <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-8 text-gray-900">Tour Details</h2>

              <div class="space-y-6 mb-8">
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Duration:</span>
                  </div>
                  <span class="text-gray-900">{data.duration}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2 2v0zM3 7a2 2 0 012-2h14a2 2 0 012 2v0M8 2v4m8-4v4"/>
                    </svg>
                    <span class="font-medium text-gray-600">Season:</span>
                  </div>
                  <span class="text-gray-900">{data.season}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Max People:</span>
                  </div>
                  <span class="text-gray-900">{data.maxPeople}</span>
                </div>
                <div class="flex justify-between items-center border-b border-gray-200 pb-3">
                  <div class="flex items-center gap-3">
                    <svg class="w-5 h-5 text-[var(--secondary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                    </svg>
                    <span class="font-medium text-gray-600">Difficulty:</span>
                  </div>
                  <span class="text-gray-900">{data.difficultyLevel}</span>
                </div>
              </div>

            </div>

            <!-- Highlights -->
            {data.highlights && data.highlights.length > 0 && (
              <div class="slide-left">
                <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-8 text-gray-900">Highlights</h2>
                <ul class="space-y-4">
                  {data.highlights.map((highlight) => (
                    <li class="flex items-start">
                      <svg class="w-5 h-5 text-[var(--secondary)] mt-1 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- Gallery Section -->
      {data.gallery && data.gallery.length > 0 && (
        <section class="fade-in bg-gray-50 py-16 lg:py-24 overflow-hidden">
          <div class="max-w-7xl mx-auto px-8">
            <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Gallery</h2>

            <!-- Infinite Scroll Gallery -->
            <div class="gallery-container">
              <!-- Single row infinity scroll -->
              <div class="gallery-track">
                <div class="gallery-slide-group">
                  {data.gallery.map((image, index) => (
                    <div class="gallery-item">
                      <div class="block aspect-square overflow-hidden rounded-sm">
                        <OptimizedImage
                          src={image.srcPC}
                          alt={image.alt || ''}
                          class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
                          sizes="(max-width: 767px) 250px, (max-width: 1023px) 312px, 375px"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  ))}
                </div>
                <!-- Duplicate for seamless loop -->
                <div class="gallery-slide-group">
                  {data.gallery.map((image, index) => (
                    <div class="gallery-item">
                      <div class="block aspect-square overflow-hidden rounded-sm">
                        <OptimizedImage
                          src={image.srcPC}
                          alt={image.alt || ''}
                          class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-300"
                          sizes="(max-width: 767px) 250px, (max-width: 1023px) 312px, 375px"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>

            </div>
          </div>
        </section>
      )}

      <!-- Video Section -->
      <section class="fade-in py-16 lg:py-24">
        <div class="max-w-4xl mx-auto px-8">
          <div class="tour-video-container slide-up">
            <Content />
          </div>
        </div>
      </section>

      <!-- Visits Section -->
      {data.visits && data.visits.length > 0 && (
        <section class="fade-in py-16 lg:py-24">
          <div class="max-w-6xl mx-auto px-8">
            <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">What You'll Visit</h2>
            <div class="space-y-4">
              {data.visits.map((visit, index) => (
                <div class={`visit-accordion slide-${index % 2 === 0 ? 'right' : 'left'} bg-white rounded-sm shadow-lg overflow-hidden`}>
                  <button
                    class="accordion-trigger w-full text-left p-6 hover:bg-gray-50 transition-colors duration-200 flex justify-between items-center"
                    aria-expanded="false"
                    data-accordion-target={`visit-${index}`}
                  >
                    <h3 class="text-2xl md:text-3xl font-light tracking-wide text-gray-900">{visit.name}</h3>
                    <svg
                      class="accordion-icon w-6 h-6 text-gray-400 transition-transform duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>
                  <div
                    class="accordion-content max-h-0 overflow-hidden transition-all duration-300 ease-out"
                    id={`visit-${index}`}
                  >
                    <div class="p-8 pt-0">
                      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div class="lg:order-2">
                          {visit.image && (
                            <div class="block aspect-square overflow-hidden rounded-sm">
                              <OptimizedImage
                                src={visit.image.srcPC}
                                alt={visit.image.alt || ''}
                                class="w-full h-full object-cover object-center"
                                sizes="(max-width: 1024px) 100vw, 50vw"
                                loading="lazy"
                              />
                            </div>
                          )}
                        </div>
                        <div class="lg:order-1">
                          <div class="text-gray-700 leading-relaxed text-base lg:text-lg" set:html={visit.description}></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      <!-- Booking Section -->
      <section id="booking" class="fade-in bg-gray-50 py-16 lg:py-24">
        <div class="max-w-6xl mx-auto px-8">
          <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Book Your Tour</h2>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            {data.priceMercedes && (
              <div class="bg-white p-8 rounded-sm shadow-lg hover:shadow-xl transition-shadow duration-300 slide-right">
                <div class="mb-6">
                  <OptimizedImage
                    src="/pictures/vehicles/mercedes-v-class.jpg"
                    alt="Mercedes V-Class luxury vehicle"
                    class="w-full h-48 object-cover object-center rounded-sm"
                    sizes="(max-width: 1024px) 100vw, 50vw"
                    widths={[320, 640, 960]}
                    loading="lazy"
                  />
                </div>
                <h3 class="text-2xl font-light tracking-wide mb-4 text-gray-900">Mercedes V-Class</h3>
                <p class="text-gray-600 mb-4">Luxury vehicle for up to <strong>6 passengers</strong> with premium comfort and amenities.</p>

                <div class="mb-6">
                  <div class="text-2xl font-light text-gray-900 mb-2">{data.priceMercedes.toLocaleString()} ISK</div>
                  <div class="text-sm text-gray-500 space-x-4">
                    <span>≈ ${Math.round(data.priceMercedes * exchangeRates.USD).toLocaleString()} USD</span>
                    <span>≈ €{Math.round(data.priceMercedes * exchangeRates.EUR).toLocaleString()} EUR</span>
                  </div>
                </div>

                {data.bookingLinkMercedes && (
                  <a
                    href={data.bookingLinkMercedes}
                    class="booking-cta-button inline-block w-full text-center bg-transparent text-[var(--secondary)] border border-[var(--secondary)] px-6 py-3 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:text-white hover:translate-y-0.5"
                  >
                    Book your tour
                  </a>
                )}
              </div>
            )}

            {data.priceLandCruiser && (
              <div class="bg-white p-8 rounded-sm shadow-lg hover:shadow-xl transition-shadow duration-300 slide-left">
                <div class="mb-6">
                  <OptimizedImage
                    src="/pictures/vehicles/toyota-land-cruiser.jpg"
                    alt="Toyota Land Cruiser adventure vehicle"
                    class="w-full h-48 object-cover object-center rounded-sm"
                    sizes="(max-width: 1024px) 100vw, 50vw"
                    widths={[320, 640, 960]}
                    loading="lazy"
                  />
                </div>
                <h3 class="text-2xl font-light tracking-wide mb-4 text-gray-900">Toyota Land Cruiser</h3>
                <p class="text-gray-600 mb-4">Rugged 4x4 vehicle for up to <strong>4 passengers</strong>, perfect for Iceland's terrain.</p>

                <div class="mb-6">
                  <div class="text-2xl font-light text-gray-900 mb-2">{data.priceLandCruiser.toLocaleString()} ISK</div>
                  <div class="text-sm text-gray-500 space-x-4">
                    <span>≈ ${Math.round(data.priceLandCruiser * exchangeRates.USD).toLocaleString()} USD</span>
                    <span>≈ €{Math.round(data.priceLandCruiser * exchangeRates.EUR).toLocaleString()} EUR</span>
                  </div>
                </div>

                {data.bookingLinkLandCruiser && (
                  <a
                    href={data.bookingLinkLandCruiser}
                    class="booking-cta-button inline-block w-full text-center bg-transparent text-[var(--secondary)] border border-[var(--secondary)] px-6 py-3 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:text-white hover:translate-y-0.5"
                  >
                    Book your tour
                  </a>
                )}
              </div>
            )}
          </div>

          {data.bookingLinkMeetOnLocation && (
            <div class="max-w-2xl mx-auto slide-up">
              <div class="bg-white p-8 rounded-sm shadow-lg text-center">
                <h3 class="text-2xl font-light tracking-wide mb-4 text-gray-900">Meet on Location</h3>
                <p class="text-gray-600 mb-6">Join the tour at the starting location with your own transportation.</p>
                <a
                  href={data.bookingLinkMeetOnLocation}
                  class="meet-location-cta inline-block bg-transparent text-gray-800 border border-gray-800 px-8 py-3 rounded-sm font-medium tracking-wide relative overflow-hidden transition-all duration-300 hover:text-white hover:translate-y-0.5"
                >
                  Book Meet on Location
                </a>
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- Personalize Your Tour Section -->
      <section class="fade-in py-16 lg:py-24">
        <div class="max-w-4xl mx-auto px-8">
          <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-6 text-center text-gray-900 slide-down">Personalize Your Tour</h2>
          <p class="text-center text-gray-600 mb-12 text-lg">Have specific requests or questions? Let us tailor this experience to your needs.</p>

          <div class="bg-white p-8 rounded-sm shadow-lg slide-up">
            <form id="tour-contact-form" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="contact-name" class="block text-sm font-medium text-gray-700 mb-2">
                    Your Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
                    placeholder="John Doe"
                  />
                </div>

                <div>
                  <label for="contact-email" class="block text-sm font-medium text-gray-700 mb-2">
                    Email Address <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
                    placeholder="john@example.com"
                  />
                </div>
              </div>

              <div>
                <label for="contact-phone" class="block text-sm font-medium text-gray-700 mb-2">
                  Your Phone Number
                </label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
                  placeholder="+1 234 567 8900"
                />
              </div>

              <div>
                <label for="contact-message" class="block text-sm font-medium text-gray-700 mb-2">
                  Your Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="6"
                  class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 resize-y"
                  placeholder="Tell us about your preferences, special requests, or any questions you have about this tour..."
                ></textarea>
              </div>

              <div id="form-message" class="hidden p-4 rounded-sm"></div>

              <button
                type="submit"
                id="contact-submit"
                class="w-full bg-[var(--secondary)] text-white px-8 py-4 rounded-sm font-medium tracking-wide hover:bg-[#5b7297] transition-all duration-300 transform hover:translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--secondary)]"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>
      </section>

      <!-- Related Tours Section -->
      {randomTours.length > 0 && (
        <section class="fade-in bg-gray-50 py-16 lg:py-24">
          <div class="max-w-7xl mx-auto px-8">
            <h2 class="text-4xl md:text-5xl font-light tracking-wide mb-16 text-center text-gray-900 slide-down">Explore More Day Tours</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-items-center items-stretch">
              {randomTours.map((relatedTour) => (
                <ItineraryCard
                  image={relatedTour.data.cardImg?.srcPC || relatedTour.data.featuredImage}
                  imageAlt={relatedTour.data.cardImg?.alt || relatedTour.data.title}
                  title={relatedTour.data.title}
                  duration={relatedTour.data.duration}
                  description={relatedTour.data.cardSentence}
                  price={relatedTour.data.priceMercedes?.toLocaleString() || relatedTour.data.priceLandCruiser?.toLocaleString()}
                  slug={relatedTour.data.url}
                  highlights={relatedTour.data.highlights?.slice(0, 3)}
                  season={relatedTour.data.season}
                />
              ))}
            </div>
          </div>
        </section>
      )}
    </main>

    <Footer currentLang={data.language} />

    <!-- Floating Book Button -->
    <a
      id="floating-book-button"
      href="#booking"
      class="floating-book-btn fixed bottom-8 right-8 bg-[var(--secondary)] text-white px-6 py-3 rounded-full shadow-2xl opacity-0 invisible transition-all duration-300 z-[1000] hover:bg-[#5b7297] hover:shadow-3xl hover:scale-110 flex items-center gap-2 font-medium tracking-wide no-underline"
      aria-label="Book This Tour"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span>Book Now</span>
    </a>

    <script>
      // Intersection Observer for scroll animations
      function initScrollAnimations() {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px 100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, observerOptions);

        // Observe all elements with animation classes
        const animatedElements = document.querySelectorAll(
          '.fade-in, .slide-up, .slide-down, .slide-left, .slide-right'
        );

        animatedElements.forEach((element) => {
          observer.observe(element);
        });
      }

      // Accordion functionality
      function initAccordion() {
        const accordionTriggers = document.querySelectorAll('.accordion-trigger');

        accordionTriggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const targetId = trigger.getAttribute('data-accordion-target');
            const content = document.getElementById(targetId);
            const icon = trigger.querySelector('.accordion-icon');
            const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

            // Close all other accordions
            accordionTriggers.forEach((otherTrigger) => {
              if (otherTrigger !== trigger) {
                const otherTargetId = otherTrigger.getAttribute('data-accordion-target');
                const otherContent = document.getElementById(otherTargetId);
                const otherIcon = otherTrigger.querySelector('.accordion-icon');

                otherTrigger.setAttribute('aria-expanded', 'false');
                otherContent.style.maxHeight = '0px';
                otherIcon.style.transform = 'rotate(0deg)';
              }
            });

            // Toggle current accordion
            if (isExpanded) {
              trigger.setAttribute('aria-expanded', 'false');
              content.style.maxHeight = '0px';
              icon.style.transform = 'rotate(0deg)';
            } else {
              trigger.setAttribute('aria-expanded', 'true');
              content.style.maxHeight = content.scrollHeight + 'px';
              icon.style.transform = 'rotate(180deg)';
            }
          });
        });
      }

      // Contact form handling
      function initContactForm() {
        const form = document.getElementById('tour-contact-form');
        const submitButton = document.getElementById('contact-submit');
        const formMessage = document.getElementById('form-message');

        if (!form) return;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          // Disable submit button
          submitButton.disabled = true;
          submitButton.textContent = 'Sending...';

          // Get form data
          const tourName = document.querySelector('h1').textContent.trim();
          const formDataObj = {
            name: form.querySelector('[name="name"]').value.trim(),
            email: form.querySelector('[name="email"]').value.trim(),
            phone: form.querySelector('[name="phone"]').value.trim() || 'Not provided',
            message: form.querySelector('[name="message"]').value.trim(),
            tourName: tourName
          };

          // Create FormData for PHP endpoint
          const phpFormData = new URLSearchParams();
          phpFormData.append('name', formDataObj.name);
          phpFormData.append('email', formDataObj.email);
          phpFormData.append('phone', formDataObj.phone);
          phpFormData.append('message', formDataObj.message);
          phpFormData.append('tourName', formDataObj.tourName);

          try {
            // Try PHP endpoint (works with Hostgator and most hosting)
            const response = await fetch('/contact-tour.php', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
              },
              body: phpFormData.toString()
            });

            if (response.ok) {
              const result = await response.json();

              if (result.success) {
                // Show success message
                formMessage.textContent = 'Thank you! Your message has been sent successfully. We\'ll get back to you soon.';
                formMessage.className = 'p-4 rounded-sm bg-green-50 text-green-800 border border-green-200';
                formMessage.classList.remove('hidden');

                // Reset form
                form.reset();

                // Scroll to message
                formMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                // Hide message after 5 seconds
                setTimeout(() => {
                  formMessage.classList.add('hidden');
                }, 5000);
              } else {
                throw new Error(result.error || 'Failed to send message');
              }
            } else {
              throw new Error('Server error');
            }
          } catch (error) {
            // Show error message
            formMessage.textContent = 'Sorry, there was an error sending your message. Please try again or contact us directly at julien@lilja-tours.com';
            formMessage.className = 'p-4 rounded-sm bg-red-50 text-red-800 border border-red-200';
            formMessage.classList.remove('hidden');

            // Scroll to message
            formMessage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

            console.error('Form submission error:', error);
          } finally {
            // Re-enable submit button
            submitButton.disabled = false;
            submitButton.textContent = 'Send Message';
          }
        });
      }

      // Floating button functionality
      function initFloatingButton() {
        const floatingButton = document.getElementById('floating-book-button');
        const header = document.querySelector('header');

        if (!floatingButton || !header) return;

        const headerHeight = header.offsetHeight;

        const handleScroll = () => {
          const currentScrollY = window.scrollY;

          // Show button when scrolled past header
          if (currentScrollY > headerHeight) {
            floatingButton.classList.add('show');
          } else {
            floatingButton.classList.remove('show');
          }
        };

        // Throttle scroll events
        let scrollTimeout;
        window.addEventListener('scroll', () => {
          if (scrollTimeout) {
            clearTimeout(scrollTimeout);
          }
          scrollTimeout = setTimeout(handleScroll, 10);
        }, { passive: true });

        // Initial check
        handleScroll();
      }

      // Initialize everything when DOM is loaded
      document.addEventListener('DOMContentLoaded', () => {
        initScrollAnimations();
        initAccordion();
        initContactForm();
        initFloatingButton();
      });
    </script>
  </body>
</html>