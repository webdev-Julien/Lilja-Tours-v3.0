---
/**
 * Search Results Page (English)
 * Pre-renders all cards at build time, filters via client-side JS
 */
import "../styles/global.css"
import Topbar from "../components/Topbar.astro"
import Footer from "../components/Footer.astro"
import OptimizedImage from '../components/OptimizedImage.astro'
import ItineraryCard from "../components/ItineraryCard.astro"
import MultidayItineraryCard from "../components/MultidayItineraryCard.astro"
import ExperienceCard from "../components/ExperienceCard.astro"
import BlogCard from "../components/BlogCard.astro"
import { getCollection } from 'astro:content';
import { translations, urls } from '../i18n/translations';
import { normalizeForSearch } from '../utils/icelandicNormalization';
import fs from 'node:fs';
import path from 'node:path';

const currentLang = 'en';
const t = translations[currentLang];

// Load all collections
const dayTours = await getCollection('tours_EN');
const multidayTours = await getCollection('multiday_tours_EN');
const experiences = await getCollection('partner_experiences_EN');
const blogArticles = await getCollection('blog_articles_EN');
const transfers = await getCollection('transfers_EN');

// Helper to strip HTML and limit content
function stripAndLimit(text: string, limit: number = 500): string {
  if (!text) return '';
  // Remove MDX/HTML tags
  const stripped = text.replace(/<[^>]*>/g, '').replace(/\{[^}]*\}/g, '');
  return stripped.substring(0, limit);
}

// Helper function to format duration from ISO 8601
function formatDuration(duration: string): string {
  const match = duration.match(/PT(\d+)H?(\d+)?M?/);
  if (match) {
    const hours = match[1] ? parseInt(match[1]) : 0;
    const minutes = match[2] ? parseInt(match[2]) : 0;
    if (hours && minutes) return `${hours}h ${minutes}min`;
    if (hours) return `${hours}h`;
    if (minutes) return `${minutes}min`;
  }
  return duration;
}

// Helper function to format price
function formatPrice(price: number): string {
  return new Intl.NumberFormat('en-US').format(price);
}

// Generate search index with normalized fields for Icelandic character support
const searchIndex = [
  ...dayTours.map(tour => {
    const title = tour.data.title;
    const description = tour.data.metaDescription;
    const content = stripAndLimit(tour.data.introductoryText + ' ' + tour.data.highlights.join(' '));
    return {
      id: `tour-${tour.slug}`,
      type: 'tour',
      title,
      description,
      content,
      url: tour.data.url,
      // Normalized fields for Icelandic character search
      titleNorm: normalizeForSearch(title),
      descNorm: normalizeForSearch(description),
      contentNorm: normalizeForSearch(content)
    };
  }),
  ...multidayTours.map(tour => {
    const title = tour.data.title;
    const description = tour.data.metaDescription;
    const content = stripAndLimit(tour.data.introductoryText + ' ' + tour.data.highlights.join(' '));
    return {
      id: `multiday-${tour.slug}`,
      type: 'multiday',
      title,
      description,
      content,
      url: tour.data.url,
      titleNorm: normalizeForSearch(title),
      descNorm: normalizeForSearch(description),
      contentNorm: normalizeForSearch(content)
    };
  }),
  ...experiences.map(exp => {
    const title = exp.data.title;
    const description = exp.data.metaDescription;
    const content = stripAndLimit(exp.data.introductoryText + ' ' + exp.data.highlights.join(' '));
    return {
      id: `experience-${exp.slug}`,
      type: 'experience',
      title,
      description,
      content,
      url: exp.data.url,
      titleNorm: normalizeForSearch(title),
      descNorm: normalizeForSearch(description),
      contentNorm: normalizeForSearch(content)
    };
  }),
  ...blogArticles.map(article => {
    const title = article.data.title;
    const description = article.data.metaDescription;
    const content = stripAndLimit(article.data.excerpt);
    return {
      id: `blog-${article.slug}`,
      type: 'blog',
      title,
      description,
      content,
      url: `/blog/${article.slug}/`,
      titleNorm: normalizeForSearch(title),
      descNorm: normalizeForSearch(description),
      contentNorm: normalizeForSearch(content)
    };
  }),
  ...transfers.map(transfer => {
    const title = transfer.data.title;
    const description = transfer.data.metaDescription;
    const content = stripAndLimit(transfer.data.introductoryText + ' ' + transfer.data.cardText);
    return {
      id: `transfer-${transfer.slug}`,
      type: 'transfer',
      title,
      description,
      content,
      url: transfer.data.url,
      titleNorm: normalizeForSearch(title),
      descNorm: normalizeForSearch(description),
      contentNorm: normalizeForSearch(content)
    };
  })
];

// Write search index to both public and dist folders at build time
// Public folder for dev server, dist folder for production build
const publicDir = path.join(process.cwd(), 'public', 'search');
const distDir = path.join(process.cwd(), 'dist', 'search');

// Create directories if they don't exist
if (!fs.existsSync(publicDir)) {
  fs.mkdirSync(publicDir, { recursive: true });
}
if (!fs.existsSync(distDir)) {
  fs.mkdirSync(distDir, { recursive: true });
}

// Write to both locations
const indexJson = JSON.stringify(searchIndex);
fs.writeFileSync(path.join(publicDir, 'index-en.json'), indexJson);
fs.writeFileSync(path.join(distDir, 'index-en.json'), indexJson);

// Select fallback items (3 tours, 3 experiences, 3 articles)
const fallbackTours = dayTours.slice(0, 3);
const fallbackExperiences = experiences.slice(0, 3);
const fallbackArticles = blogArticles.slice(0, 3);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large">
    <meta name="description" content="Search tours, experiences, and articles on Lilja Tours. Find your perfect Iceland adventure.">
    <link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/search/" />
    <link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/recherche/" />
    <link rel="canonical" href="https://www.lilja-tours.com/search/" />

    <meta property="og:title" content="Search | Lilja Tours">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.lilja-tours.com/search/">
    <meta property="og:description" content="Search tours, experiences, and articles on Lilja Tours.">

    <!-- Apple Touch Icon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <!-- Standard Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <meta name="generator" content={Astro.generator} />
    <title>Search | Lilja Tours</title>

    <!-- GDPR Cookie Consent -->
    <link rel="stylesheet" href="/css/gdpr-consent.css" />
    <script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

    <!-- TrustIndex Rich Snippet -->
    <script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-48C94854K2"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Set linker before the config command
      gtag('set', 'linker', {
        'domains': ['bokun.io']
      });

      gtag('js', new Date());
      gtag('config', 'G-48C94854K2');
    </script>
  </head>
  <body>
    <!-- Header Section -->
    <header class="relative h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden">
      <Topbar frenchUrl="/fr/recherche/" currentLang="en" />

      <!-- Background Image -->
      <OptimizedImage
        src="/pictures/headers/search-page-header-pc.jpg"
        alt="Search Iceland Tours"
        class="absolute inset-0 w-full h-full object-cover"
        sizes="100vw"
        loading="eager"
      />

      <!-- Overlay -->
      <div class="absolute inset-0 bg-black/40"></div>

      <!-- Content -->
      <div class="relative z-10 text-center max-w-4xl mx-auto px-8 mt-[70px]">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-8 leading-tight text-white">Search</h1>

        <!-- Search Form -->
        <form id="search-form" action="/search/" method="GET" class="w-full max-w-2xl mx-auto">
          <div class="relative">
            <input
              type="text"
              id="search-input"
              name="q"
              placeholder={t.search.placeholder}
              autocomplete="off"
              class="w-full bg-white/10 border border-white/30 rounded-sm px-6 py-4 text-white text-lg md:text-xl placeholder-white/50 focus:outline-none focus:border-white/60 focus:bg-white/15 transition-all duration-200 backdrop-blur-sm"
            />
            <button type="submit" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </header>

    <main>
      <!-- Results Header -->
      <section class="bg-white py-12 border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-8">
          <div id="results-header" class="text-center">
            <p id="results-status" class="text-lg text-gray-600 font-light"></p>
          </div>
        </div>
      </section>

      <!-- Day Tours Section -->
      <section id="section-tours" class="bg-white py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-12 text-gray-900">{t.search.dayTours}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {dayTours.map((tour) => (
              <div class="search-card" data-search-id={`tour-${tour.slug}`} data-type="tour">
                <ItineraryCard
                  image={tour.data.cardImg.srcPC}
                  imageAlt={tour.data.cardImg.alt}
                  title={tour.data.title}
                  duration={tour.data.duration}
                  description={tour.data.cardSentence}
                  price={tour.data.price ? `From ${tour.data.price}` : undefined}
                  highlights={tour.data.highlights.filter(h => h.trim() !== "")}
                  season={tour.data.season}
                  slug={tour.data.url}
                  currentLang="en"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Multiday Tours Section -->
      <section id="section-multiday" class="bg-gray-50 py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-12 text-gray-900">{t.search.multidayTours}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {multidayTours.map((tour) => (
              <div class="search-card" data-search-id={`multiday-${tour.slug}`} data-type="multiday">
                <MultidayItineraryCard
                  image={tour.data.cardImg.srcPC}
                  imageAlt={tour.data.cardImg.alt}
                  title={tour.data.title}
                  duration={tour.data.duration}
                  description={tour.data.cardSentence}
                  price={tour.data.price?.toString()}
                  highlights={tour.data.highlights.filter(h => h.trim() !== "")}
                  season={tour.data.season}
                  slug={tour.slug}
                  currentLang="en"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Experiences Section -->
      <section id="section-experiences" class="bg-white py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-12 text-gray-900">{t.search.experiences}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {experiences.map((exp) => (
              <div class="search-card" data-search-id={`experience-${exp.slug}`} data-type="experience">
                <ExperienceCard
                  image={exp.data.cardImg.srcPC}
                  imageAlt={exp.data.cardImg.alt}
                  title={exp.data.title}
                  duration={exp.data.duration}
                  description={exp.data.shortDescription}
                  price={exp.data.price}
                  location={exp.data.location}
                  season={exp.data.season}
                  slug={exp.data.url}
                  isExclusive={exp.data.isExclusive}
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Blog Articles Section -->
      <section id="section-blog" class="bg-gray-50 py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-12 text-gray-900">{t.search.articles}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {blogArticles.map((article) => (
              <div class="search-card" data-search-id={`blog-${article.slug}`} data-type="blog">
                <BlogCard
                  image={article.data.cardImg.srcPC}
                  imageAlt={article.data.cardImg.alt}
                  title={article.data.title}
                  excerpt={article.data.excerpt}
                  publishDate={article.data.publishDate}
                  readingTime={article.data.readingTime}
                  categories={article.data.categories}
                  slug={`/blog/${article.slug}/`}
                  author={article.data.author}
                  lang="en"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Transfers Section -->
      <section id="section-transfers" class="bg-white py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-12 text-gray-900">{t.search.transfers}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {transfers.map((transfer) => (
              <div class="search-card" data-search-id={`transfer-${transfer.slug}`} data-type="transfer">
                <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
                  <OptimizedImage
                    src={transfer.data.cardImg.src}
                    alt={transfer.data.cardImg.alt}
                    class="w-full h-48 object-cover"
                    sizes="(max-width: 768px) 100vw, 33vw"
                    loading="lazy"
                  />
                  <div class="p-6 flex flex-col flex-1">
                    <h3 class="text-xl font-medium text-gray-900 mb-2">{transfer.data.title}</h3>
                    <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <span>{formatDuration(transfer.data.duration)}</span>
                    </div>
                    <p class="text-gray-600 text-sm mb-4 flex-1">{transfer.data.cardText}</p>
                    <div class="flex items-center justify-between mb-4">
                      <span class="text-lg font-medium text-[#5b7297]">{formatPrice(transfer.data.price)} ISK</span>
                    </div>
                    <div class="flex gap-3 mt-auto">
                      <a
                        href={transfer.data.url}
                        class="flex-1 text-center py-2 px-4 border border-[#5b7297] text-[#5b7297] rounded-sm text-sm font-medium hover:bg-[#5b7297] hover:text-white transition-colors duration-300"
                      >
                        Learn More
                      </a>
                      <a
                        href={transfer.data.bookingLink}
                        class="flex-1 text-center py-2 px-4 bg-[#5b7297] text-white rounded-sm text-sm font-medium hover:bg-[#4a6180] transition-colors duration-300"
                      >
                        Book Now
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- No Results / Fallback Section -->
      <section id="section-fallback" class="bg-white py-16 hidden">
        <div class="max-w-7xl mx-auto px-8">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-light tracking-wide mb-4 text-gray-900">{t.search.noResults}</h2>
            <p class="text-lg text-gray-600 font-light">{t.search.noResultsSubtext}</p>
          </div>

          <!-- Fallback Tours -->
          <div class="mb-16">
            <h3 class="text-2xl font-light tracking-wide mb-8 text-gray-800">{t.search.dayTours}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
              {fallbackTours.map((tour) => (
                <ItineraryCard
                  image={tour.data.cardImg.srcPC}
                  imageAlt={tour.data.cardImg.alt}
                  title={tour.data.title}
                  duration={tour.data.duration}
                  description={tour.data.cardSentence}
                  price={tour.data.price ? `From ${tour.data.price}` : undefined}
                  highlights={tour.data.highlights.filter(h => h.trim() !== "")}
                  season={tour.data.season}
                  slug={tour.data.url}
                  currentLang="en"
                />
              ))}
            </div>
          </div>

          <!-- Fallback Experiences -->
          <div class="mb-16">
            <h3 class="text-2xl font-light tracking-wide mb-8 text-gray-800">{t.search.experiences}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
              {fallbackExperiences.map((exp) => (
                <ExperienceCard
                  image={exp.data.cardImg.srcPC}
                  imageAlt={exp.data.cardImg.alt}
                  title={exp.data.title}
                  duration={exp.data.duration}
                  description={exp.data.shortDescription}
                  price={exp.data.price}
                  location={exp.data.location}
                  season={exp.data.season}
                  slug={exp.data.url}
                  isExclusive={exp.data.isExclusive}
                />
              ))}
            </div>
          </div>

          <!-- Fallback Articles -->
          <div>
            <h3 class="text-2xl font-light tracking-wide mb-8 text-gray-800">{t.search.articles}</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
              {fallbackArticles.map((article) => (
                <BlogCard
                  image={article.data.cardImg.srcPC}
                  imageAlt={article.data.cardImg.alt}
                  title={article.data.title}
                  excerpt={article.data.excerpt}
                  publishDate={article.data.publishDate}
                  readingTime={article.data.readingTime}
                  categories={article.data.categories}
                  slug={`/blog/${article.slug}/`}
                  author={article.data.author}
                  lang="en"
                />
              ))}
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer currentLang="en" />

    <script>
      // Search functionality
      console.log('[SearchPage] Script loaded');
      document.addEventListener('DOMContentLoaded', async () => {
        console.log('[SearchPage] DOMContentLoaded fired');
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        console.log('[SearchPage] searchInput found:', !!searchInput);
        const resultsStatus = document.getElementById('results-status');
        const sectionTours = document.getElementById('section-tours');
        const sectionMultiday = document.getElementById('section-multiday');
        const sectionExperiences = document.getElementById('section-experiences');
        const sectionBlog = document.getElementById('section-blog');
        const sectionTransfers = document.getElementById('section-transfers');
        const sectionFallback = document.getElementById('section-fallback');
        const allCards = document.querySelectorAll('.search-card');

        // Icelandic character normalization
        const icelandicToAscii: Record<string, string> = {
          'á': 'a', 'ð': 'd', 'é': 'e', 'í': 'i', 'ó': 'o', 'ú': 'u', 'ý': 'y',
          'þ': 'th', 'æ': 'ae', 'ö': 'o',
          'Á': 'A', 'Ð': 'D', 'É': 'E', 'Í': 'I', 'Ó': 'O', 'Ú': 'U', 'Ý': 'Y',
          'Þ': 'Th', 'Æ': 'Ae', 'Ö': 'O'
        };

        function normalizeIcelandic(text: string): string {
          if (!text) return '';
          let result = text;
          for (const [icelandic, ascii] of Object.entries(icelandicToAscii)) {
            result = result.split(icelandic).join(ascii);
          }
          return result;
        }

        function normalizeForSearch(text: string): string {
          return normalizeIcelandic(text).toLowerCase();
        }

        // Translations
        const t = {
          resultsFor: 'Results for',
          results: 'results',
          result: 'result',
          noResults: 'No results found',
          searching: 'Searching...',
          typeToSearch: 'Type to search...',
          loading: 'Loading...'
        };

        // Get query from URL
        const urlParams = new URLSearchParams(window.location.search);
        const query = urlParams.get('q') || '';

        if (searchInput && query) {
          searchInput.value = query;
        }

        // Fuse.js class reference
        let FuseClass: any = null;

        // Load Fuse.js dynamically using ESM import
        async function loadFuseJS(): Promise<void> {
          if (FuseClass) return;
          try {
            const FuseModule = await import('https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.mjs');
            FuseClass = FuseModule.default;
            console.log('[SearchPage] Fuse.js ESM loaded successfully');
          } catch (error) {
            console.error('[SearchPage] Failed to load Fuse.js:', error);
            throw error;
          }
        }

        // Load search index
        let searchIndex: any[] = [];
        let fuse: any = null;

        // Show loading state
        if (resultsStatus) resultsStatus.textContent = t.loading;

        try {
          // Load Fuse.js first
          console.log('[SearchPage] Loading Fuse.js...');
          await loadFuseJS();
          console.log('[SearchPage] Fuse.js loaded, FuseClass:', !!FuseClass);

          console.log('[SearchPage] Fetching search index...');
          const response = await fetch('/search/index-en.json');
          console.log('[SearchPage] Fetch response:', response.status, response.ok);
          if (response.ok) {
            searchIndex = await response.json();
            console.log('[SearchPage] Index loaded, items:', searchIndex.length);
            if (FuseClass) {
              // Include both original and normalized fields for Icelandic character support
              fuse = new FuseClass(searchIndex, {
                keys: [
                  { name: 'title', weight: 0.2 },
                  { name: 'description', weight: 0.15 },
                  { name: 'content', weight: 0.15 },
                  { name: 'titleNorm', weight: 0.2 },
                  { name: 'descNorm', weight: 0.15 },
                  { name: 'contentNorm', weight: 0.15 }
                ],
                threshold: 0.4,
                ignoreLocation: true,
                minMatchCharLength: 2
              });
              console.log('[SearchPage] Fuse initialized:', !!fuse);
            } else {
              console.error('[SearchPage] FuseClass not available after loading!');
            }
          } else {
            console.error('[SearchPage] Failed to fetch index, status:', response.status);
          }
        } catch (error) {
          console.error('[SearchPage] Failed to load search index:', error);
        }

        console.log('[SearchPage] Initialization complete, fuse:', !!fuse);

        // Hide all cards initially
        function hideAllCards() {
          allCards.forEach(card => {
            (card as HTMLElement).style.display = 'none';
          });
        }

        // Show cards by IDs
        function showCards(ids: string[]) {
          const typeCounts: Record<string, number> = {
            tour: 0,
            multiday: 0,
            experience: 0,
            blog: 0,
            transfer: 0
          };

          allCards.forEach(card => {
            const cardId = card.getAttribute('data-search-id');
            const cardType = card.getAttribute('data-type');

            if (cardId && ids.includes(cardId)) {
              (card as HTMLElement).style.display = 'block';
              if (cardType) typeCounts[cardType]++;
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });

          return typeCounts;
        }

        // Show/hide sections based on results
        function updateSections(typeCounts: Record<string, number>) {
          if (sectionTours) sectionTours.classList.toggle('hidden', typeCounts.tour === 0);
          if (sectionMultiday) sectionMultiday.classList.toggle('hidden', typeCounts.multiday === 0);
          if (sectionExperiences) sectionExperiences.classList.toggle('hidden', typeCounts.experience === 0);
          if (sectionBlog) sectionBlog.classList.toggle('hidden', typeCounts.blog === 0);
          if (sectionTransfers) sectionTransfers.classList.toggle('hidden', typeCounts.transfer === 0);
        }

        // Check if all query words are present in the item (supports Icelandic characters)
        function matchesAllWords(item: any, queryWords: string[]): boolean {
          // Check both original and normalized text
          const originalText = `${item.title} ${item.description} ${item.content}`.toLowerCase();
          const normalizedText = `${item.titleNorm || ''} ${item.descNorm || ''} ${item.contentNorm || ''}`;

          return queryWords.every(word => {
            const normalizedWord = normalizeForSearch(word);
            // Match if word is found in either original or normalized text
            return originalText.includes(word) ||
                   originalText.includes(normalizedWord) ||
                   normalizedText.includes(word) ||
                   normalizedText.includes(normalizedWord);
          });
        }

        // Escape HTML to prevent XSS attacks
        function escapeHtml(text: string): string {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        // Perform search
        function performSearch(searchQuery: string) {
          if (!searchQuery || searchQuery.length < 2) {
            // No query - show fallback
            hideAllCards();
            if (sectionTours) sectionTours.classList.add('hidden');
            if (sectionMultiday) sectionMultiday.classList.add('hidden');
            if (sectionExperiences) sectionExperiences.classList.add('hidden');
            if (sectionBlog) sectionBlog.classList.add('hidden');
            if (sectionTransfers) sectionTransfers.classList.add('hidden');
            if (sectionFallback) sectionFallback.classList.remove('hidden');
            if (resultsStatus) resultsStatus.textContent = '';
            return;
          }

          if (sectionFallback) sectionFallback.classList.add('hidden');

          if (!fuse) {
            if (resultsStatus) resultsStatus.textContent = t.searching;
            return;
          }

          // Get query words for phrase matching (both original and normalized)
          const queryWords = searchQuery.toLowerCase().split(/\s+/).filter(w => w.length > 1);

          // Search with both original query and normalized query for better Icelandic support
          const normalizedQuery = normalizeForSearch(searchQuery);
          const results = fuse.search(searchQuery);
          const normalizedResults = searchQuery !== normalizedQuery ? fuse.search(normalizedQuery) : [];

          // Combine and deduplicate results
          const seenIds = new Set<string>();
          const combinedResults: any[] = [];

          [...results, ...normalizedResults].forEach((r: any) => {
            if (!seenIds.has(r.item.id)) {
              seenIds.add(r.item.id);
              combinedResults.push(r);
            }
          });

          const filteredResults = combinedResults.filter((r: any) => matchesAllWords(r.item, queryWords));
          const matchingIds = filteredResults.map((r: any) => r.item.id);
          const totalResults = matchingIds.length;

          if (totalResults === 0) {
            hideAllCards();
            if (sectionTours) sectionTours.classList.add('hidden');
            if (sectionMultiday) sectionMultiday.classList.add('hidden');
            if (sectionExperiences) sectionExperiences.classList.add('hidden');
            if (sectionBlog) sectionBlog.classList.add('hidden');
            if (sectionTransfers) sectionTransfers.classList.add('hidden');
            if (sectionFallback) sectionFallback.classList.remove('hidden');
            if (resultsStatus) resultsStatus.innerHTML = `${t.noResults} "<strong>${escapeHtml(searchQuery)}</strong>"`;
            return;
          }

          const typeCounts = showCards(matchingIds);
          updateSections(typeCounts);

          const resultWord = totalResults === 1 ? t.result : t.results;
          if (resultsStatus) {
            resultsStatus.innerHTML = `${t.resultsFor} "<strong>${escapeHtml(searchQuery)}</strong>" - ${totalResults} ${resultWord}`;
          }
        }

        // Initial search if query exists
        if (query) {
          // Wait a bit for Fuse to initialize
          setTimeout(() => performSearch(query), 100);
        } else {
          // No query - show fallback section
          if (sectionFallback) sectionFallback.classList.remove('hidden');
          if (resultsStatus) resultsStatus.textContent = '';
        }

        // Live search on input
        let debounceTimer: ReturnType<typeof setTimeout>;
        searchInput?.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          const newQuery = (e.target as HTMLInputElement).value.trim();

          debounceTimer = setTimeout(() => {
            // Update URL without reload
            const newUrl = newQuery
              ? `${window.location.pathname}?q=${encodeURIComponent(newQuery)}`
              : window.location.pathname;
            window.history.replaceState({}, '', newUrl);

            performSearch(newQuery);
          }, 300);
        });
      });
    </script>

    <style>
      .search-card {
        transition: opacity 0.2s ease;
      }
    </style>
  </body>
</html>
