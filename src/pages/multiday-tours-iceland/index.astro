---
import "../../../src/styles/global.css"
import "../../styles/private-day-tours.css"
import Topbar from "../../components/Topbar.astro"
import MultidayItineraryCard from "../../components/MultidayItineraryCard.astro"
import Footer from "../../components/Footer.astro"
import OptimizedImage from "../../components/OptimizedImage.astro"
import { getOgImageUrl } from "../../utils/images"
import { getCollection } from 'astro:content';

// Get all multiday tours from the collection
const allMultidayTours = await getCollection('multiday_tours_EN');

// Generate optimized OG image URL
const ogImageUrl = getOgImageUrl("/pictures/index/multiday-bg.jpg");
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Discover our customized multiday tours in Iceland. From Ring Road adventures to tailored expeditions, explore Iceland's most spectacular destinations with expert local guides and luxury accommodations.">
		<link rel="alternate" hreflang="en" href="https://www.lilja-tours.com/multiday-tours-iceland/" />
		<link rel="alternate" hreflang="fr" href="https://www.lilja-tours.com/fr/circuits-multi-jours-islande/" />
		<link rel="canonical" href="https://www.lilja-tours.com/multiday-tours-iceland/" />

		<meta property="og:title" content="Multiday Tours Iceland - Tailored Adventures | Lilja Tours">
		<meta property="og:type" content="website">
		<meta property="og:image" content={ogImageUrl}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:type" content="image/jpeg">
		<meta property="og:url" content="https://www.lilja-tours.com/multiday-tours-iceland/">
		<meta property="og:description" content="Discover our customized multiday tours in Iceland. From Ring Road adventures to tailored expeditions, explore Iceland with expert local guides.">
		<meta property="og:locale" content="en_US">
		<meta property="og:locale:alternate" content="fr_FR">

		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:image" content={ogImageUrl}>

		<link rel="icon" href="/favicon.ico" type="image/x-icon">
		<meta name="generator" content={Astro.generator} />
		<title>Multiday Tours Iceland - Tailored Adventures | Lilja Tours</title>

		<!-- Resource Preloading for Performance -->
		<link rel="preload" href="/logos/topbar-logo.webp" as="image" fetchpriority="high">
		<link rel="preload" href="/videos/tours-bg.webp" as="image">
		<link rel="preconnect" href="https://www.googletagmanager.com">
		<link rel="dns-prefetch" href="https://www.googletagmanager.com">

		<!-- GDPR Cookie Consent -->
		<link rel="stylesheet" href="/css/gdpr-consent.css" />
		<script type="text/javascript" defer src="/js/gdpr-consent.js"></script>

		<!-- TrustIndex Rich Snippet -->
		<script type="text/javascript" defer async src="https://cdn.trustindex.io/assets/js/richsnippet.js?505b36156145g5ee"></script>
	</head>
	<body>

			<!-- Video Header Section -->
			<header class="video-header h-[75dvh] flex items-center justify-center relative">
						<Topbar frenchUrl="/fr/circuits-multi-jours-islande/" currentLang="en" />
				<!-- Responsive Video - Browser automatically selects appropriate source based on media query -->
				<video
					autoplay
					muted
					loop
					playsinline
					preload="auto"
					poster="/videos/tours-bg.webp"
					aria-label="Iceland multiday tours background video"
					class="video-source absolute inset-0 w-full h-full object-cover"
				>
					<!-- Desktop HD Video (1024px and above) -->
					<source src="/videos/HD/multiday-bg.mp4" type="video/mp4" media="(min-width: 1024px)">

					<!-- Tablet Medium Video (768px to 1023px) -->
					<source src="/videos/MD/multiday-bg.mp4" type="video/mp4" media="(min-width: 768px) and (max-width: 1023px)">

					<!-- Mobile Vertical Video (0px to 767px) -->
					<source src="/videos/SD/multiday-bg.mp4" type="video/mp4" media="(max-width: 767px)">
				</video>

				<div class="video-content text-center max-w-4xl mx-auto px-8 slide-down visible mt-[70px]">
					<h1 class="text-5xl md:text-6xl lg:text-7xl font-light tracking-[2px] mb-8 leading-tight text-white">Multiday Tours in Iceland</h1>
					<p class="text-lg md:text-xl lg:text-2xl font-light leading-relaxed text-white opacity-95 tracking-wide mb-8">
						Experience Iceland through fully customized multiday tours featuring diverse landscapes, luxury accommodations, and authentic local experiences.
					</p>
					<a href="#custom-tour-form" class="contact-cta-button inline-flex items-center gap-1.5 py-2.5 px-4.5 bg-transparent text-white no-underline border border-white rounded-sm font-light text-sm transition-all duration-300 flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:translate-x-px cursor-pointer">
						Ask for a fully personalized trip
					</a>
				</div>
			</header>
		<main>


			<!-- Tours Grid Section -->
			<section class="fade-in bg-white py-32">
				<div class="max-w-7xl w-full mx-auto px-8">
					<div class="text-center mb-16 max-w-4xl mx-auto slide-up">
						<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-8 leading-tight text-gray-900">Our Tailored Multiday Tours</h2>
						<p class="text-lg md:text-xl font-light leading-relaxed text-gray-600 tracking-wide mb-8">
							All our multiday tours are completely tailor-made to match your interests, preferences, and travel style. We work closely with you to design every aspect of your Icelandic adventure, from selecting the perfect accommodations to planning unique activities that bring your travel dreams to life.
						</p>
						<p class="text-base md:text-lg font-light leading-relaxed text-gray-500 tracking-wide">
							Our expert team will help you choose the ideal hotels, guesthouses, or luxury lodges, and curate exceptional experiences including glacier hikes, hot spring visits, cultural encounters, and wildlife viewing opportunities. Every journey is crafted to create your perfect Icelandic adventure.
						</p>
					</div>

					<div class="tours-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 slide-up">
						{allMultidayTours.map((tour) => (
							<MultidayItineraryCard
								image={tour.data.cardImg.srcPC || "/images/fallback-tour.jpg"}
								imageAlt={tour.data.cardImg.alt || tour.data.title}
								title={tour.data.title}
								duration={tour.data.duration || "Duration TBD"}
								description={tour.data.cardSentence || "Discover Iceland's beauty"}
								price={tour.data.price ? `${tour.data.price}` : "Price on request"}
								highlights={tour.data.highlights.filter(h => h.trim() !== "")}
								season={tour.data.season || "Year Round"}
								slug={tour.slug}
							/>
						))}
					</div>
				</div>
			</section>

			<!-- Custom Tour Form Section -->
			<section id="custom-tour-form" class="fade-in bg-gray-50 py-32">
				<div class="max-w-4xl mx-auto px-8">
					<h2 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-[2px] mb-6 text-center text-gray-900 slide-down">Design Your Perfect Journey</h2>
					<p class="text-center text-gray-600 mb-12 text-lg slide-up">Share your travel dreams with us, and we'll craft the perfect Icelandic adventure tailored to your preferences.</p>

					<div class="bg-white p-8 rounded-sm shadow-lg slide-up">
						<form id="multiday-tour-form" class="space-y-6">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="first-name" class="block text-sm font-medium text-gray-700 mb-2">
										First Name <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="first-name"
										name="firstName"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Your first name"
									/>
								</div>

								<div>
									<label for="last-name" class="block text-sm font-medium text-gray-700 mb-2">
										Last Name <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="last-name"
										name="lastName"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Your last name"
									/>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="email" class="block text-sm font-medium text-gray-700 mb-2">
										Email Address <span class="text-red-500">*</span>
									</label>
									<input
										type="email"
										id="email"
										name="email"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="john@example.com"
									/>
								</div>

								<div>
									<label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
										Phone Number <span class="text-red-500">*</span>
									</label>
									<input
										type="tel"
										id="phone"
										name="phone"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="Please include country code"
									/>
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="num-people" class="block text-sm font-medium text-gray-700 mb-2">
										Number of People <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-people"
										name="numPeople"
										required
										min="1"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder=""
									/>
								</div>

								<div>
									<label for="num-children" class="block text-sm font-medium text-gray-700 mb-2">
										How Many Children? <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-children"
										name="numChildren"
										required
										min="0"
										value="0"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="0"
									/>
								</div>
							</div>

							<div>
								<label for="children-ages" class="block text-sm font-medium text-gray-700 mb-2">
									What Age Are the Children?
								</label>
								<input
									type="text"
									id="children-ages"
									name="childrenAges"
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
									placeholder="So we find suitable activities"
								/>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div>
									<label for="num-days" class="block text-sm font-medium text-gray-700 mb-2">
										How Many Days Do You Need a Private Guide? <span class="text-red-500">*</span>
									</label>
									<input
										type="number"
										id="num-days"
										name="numDays"
										required
										min="1"
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder=""
									/>
								</div>

								<div>
									<label for="travel-dates" class="block text-sm font-medium text-gray-700 mb-2">
										When Are You Coming to Iceland? <span class="text-red-500">*</span>
									</label>
									<input
										type="text"
										id="travel-dates"
										name="travelDates"
										required
										class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										placeholder="e.g., June 15-22, 2025"
									/>
								</div>
							</div>

							<div>
								<label class="block text-sm font-medium text-gray-700 mb-2">
									What Are Your Main Interests?
								</label>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Sightseeing" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Sightseeing</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Hiking" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Hiking</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Adventure" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Adventure</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Relaxation & Hot Springs" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Relaxation & Hot Springs</span>
									</label>
									<label class="flex items-center">
										<input type="checkbox" name="interests" value="Culture" class="mr-2 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded">
										<span class="text-sm text-gray-700">Culture</span>
									</label>
								</div>
							</div>

							<div>
								<label for="accommodation-type" class="block text-sm font-medium text-gray-700 mb-2">
									Accommodation Type <span class="text-red-500">*</span>
								</label>
								<select
									id="accommodation-type"
									name="accommodationType"
									required
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
								>
									<option value="">Select accommodation type</option>
									<option value="4* hotels">4* hotels</option>
									<option value="3* hotels">3* hotels</option>
									<option value="Guesthouses">Guesthouses</option>
									<option value="Camping">Camping (we provide comfortable equipments)</option>
									<option value="Other">Other</option>
								</select>
							</div>

							<div>
								<label for="budget" class="block text-sm font-medium text-gray-700 mb-2">
									Total Budget for the Entire Group <span class="text-red-500">*</span>
								</label>
								<p class="text-xs text-gray-500 mb-3">This is your total budget for the whole trip, not per person or per day.</p>
								<div class="grid grid-cols-2 gap-4">
									<div>
										<input
											type="number"
											id="budget"
											name="budgetAmount"
											required
											min="1"
											class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
											placeholder="Amount"
										/>
									</div>
									<div>
										<select
											id="budget-currency"
											name="budgetCurrency"
											required
											class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200"
										>
											<option value="">Currency</option>
											<option value="EUR">EUR (€)</option>
											<option value="USD">USD ($)</option>
											<option value="ISK">ISK (Kr)</option>
										</select>
									</div>
								</div>
								<p class="text-xs text-gray-500 mt-3 italic">Knowing your budget helps us design a trip that matches your expectations. It allows us to recommend the right accommodations, activities, and experiences without over- or under-delivering.</p>
							</div>

							<div>
								<label for="details" class="block text-sm font-medium text-gray-700 mb-2">
									Additional Details
								</label>
								<textarea
									id="details"
									name="details"
									rows="6"
									class="w-full px-4 py-3 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 resize-y"
									placeholder="Tell us about your travel dreams, special requests, or any questions you have. The more details you provide, the better we can design your perfect Icelandic adventure..."
								></textarea>
							</div>

							<div id="form-message" class="hidden p-4 rounded-sm"></div>

							<button
								type="submit"
								id="submit-button"
								class="w-full bg-[var(--secondary)] text-white px-8 py-4 rounded-sm font-medium tracking-wide hover:bg-[#5b7297] transition-all duration-300 transform hover:translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--secondary)] cursor-pointer"
							>
								Send My Request
							</button>
						</form>
					</div>
				</div>
			</section>
		</main>

		<Footer currentLang="en" />

		<script src="/js/multiday-tours.js" defer></script>
	</body>
</html>
