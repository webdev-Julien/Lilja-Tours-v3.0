---
export interface Props {
  tourName: string;
  activities: Array<{ name: string; day: number }>;
}

const { tourName, activities } = Astro.props;
---

<div id="booking-modal" class="modal-overlay hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-[2000] flex items-center justify-center p-4">
  <div class="modal-content bg-white rounded-sm shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto relative">
    <button id="close-modal" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors duration-200 z-10 cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <div class="p-6 sm:p-8">
      <h3 class="text-2xl md:text-3xl font-light tracking-wide mb-2 text-gray-900 pr-8">Book This Tour</h3>
      <p class="text-sm text-gray-500 mb-6">{tourName}</p>

      <form id="tour-booking-form" class="space-y-4">
        <input type="hidden" name="tourName" value={tourName} />

        <div>
          <label for="booking-name" class="block text-sm font-medium text-gray-700 mb-1">
            Name <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="booking-name"
            name="name"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 text-sm"
            placeholder="Your name"
          />
        </div>

        <div>
          <label for="booking-email" class="block text-sm font-medium text-gray-700 mb-1">
            Email Address <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="booking-email"
            name="email"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 text-sm"
            placeholder="john@example.com"
          />
        </div>

        <div>
          <label for="booking-people" class="block text-sm font-medium text-gray-700 mb-1">
            Number of People <span class="text-red-500">*</span>
          </label>
          <input
            type="number"
            id="booking-people"
            name="numPeople"
            required
            min="1"
            class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 text-sm"
            placeholder="2"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">
            Select Activities
          </label>
          <div class="border border-gray-300 rounded-sm max-h-48 overflow-y-auto p-3 space-y-2 bg-white">
            {activities.map((activity) => (
              <label class="flex items-start cursor-pointer hover:bg-gray-50 p-2 rounded transition-colors">
                <input
                  type="checkbox"
                  name="activities"
                  value={activity.name}
                  class="mt-0.5 h-4 w-4 text-[var(--secondary)] focus:ring-[var(--secondary)] border-gray-300 rounded cursor-pointer"
                />
                <span class="ml-3 text-sm text-gray-700">
                  {activity.name} <span class="text-gray-500">(Day {activity.day})</span>
                </span>
              </label>
            ))}
          </div>
          <p class="text-xs text-gray-500 mt-1">Select one or more activities</p>
        </div>

        <div>
          <label for="booking-date" class="block text-sm font-medium text-gray-700 mb-1">
            Departure Date <span class="text-red-500">*</span>
          </label>
          <input
            type="date"
            id="booking-date"
            name="departureDate"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 text-sm"
          />
        </div>

        <div>
          <label for="booking-accommodation" class="block text-sm font-medium text-gray-700 mb-1">
            Accommodation <span class="text-red-500">*</span>
          </label>
          <select
            id="booking-accommodation"
            name="accommodation"
            required
            class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:ring-2 focus:ring-[var(--secondary)] focus:border-transparent transition-all duration-200 text-sm"
          >
            <option value="">Select accommodation type</option>
            <option value="4* hotel">4* hotel</option>
            <option value="3* hotel">3* hotel</option>
            <option value="Guesthouse">Guesthouse</option>
						<option value="Camping">Camping (we provide comfortable equipments)</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div id="booking-form-message" class="hidden p-3 rounded-sm text-sm"></div>

        <button
          type="submit"
          id="booking-submit"
          class="w-full bg-[var(--secondary)] text-white px-6 py-3 rounded-sm font-medium tracking-wide hover:bg-[#5b7297] transition-all duration-300 transform hover:translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--secondary)] text-sm cursor-pointer"
        >
          Send Quote Request
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  .modal-overlay.show {
    display: flex !important;
  }

  .modal-content {
    animation: modalSlideIn 0.3s ease-out;
  }

  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom scrollbar for modal */
  .modal-content::-webkit-scrollbar {
    width: 8px;
  }

  .modal-content::-webkit-scrollbar-track {
    background: #f1f1f1;
  }

  .modal-content::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 4px;
  }

  .modal-content::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
</style>

<script>
  function initBookingModal() {
    const modal = document.getElementById('booking-modal');
    const closeButton = document.getElementById('close-modal');
    const form = document.getElementById('tour-booking-form');
    const submitButton = document.getElementById('booking-submit');
    const formMessage = document.getElementById('booking-form-message');
    const bookButtons = document.querySelectorAll('[data-open-booking-modal]');

    if (!modal || !form) return;

    // Open modal
    bookButtons.forEach(button => {
      button.addEventListener('click', () => {
        modal.classList.remove('hidden');
        modal.classList.add('show');
        document.body.style.overflow = 'hidden';
      });
    });

    // Close modal
    const closeModal = () => {
      modal.classList.remove('show');
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    };

    closeButton?.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('show')) {
        closeModal();
      }
    });

    // Form submission
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitButton.disabled = true;
      submitButton.textContent = 'Sending...';

      const formData = new FormData(form);
      const selectedActivities = Array.from(form.querySelectorAll('[name="activities"]:checked'))
        .map(checkbox => checkbox.value);

      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        numPeople: formData.get('numPeople'),
        activities: selectedActivities.join(', ') || 'No activities selected',
        departureDate: formData.get('departureDate'),
        accommodation: formData.get('accommodation'),
        tourName: formData.get('tourName')
      };

      const phpFormData = new URLSearchParams();
      Object.keys(data).forEach(key => {
        phpFormData.append(key, data[key]);
      });

      try {
        const response = await fetch('/contact-tour-booking.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: phpFormData.toString()
        });

        if (response.ok) {
          const result = await response.json();

          if (result.success) {
            formMessage.textContent = 'Thank you! Your booking request has been sent. We\'ll contact you within 24 hours.';
            formMessage.className = 'p-3 rounded-sm text-sm bg-green-50 text-green-800 border border-green-200';
            formMessage.classList.remove('hidden');

            form.reset();

            setTimeout(() => {
              closeModal();
              formMessage.classList.add('hidden');
            }, 3000);
          } else {
            throw new Error(result.error || 'Failed to send request');
          }
        } else {
          throw new Error('Server error');
        }
      } catch (error) {
        formMessage.textContent = 'Sorry, there was an error. Please try again or contact us at julien@lilja-tours.com';
        formMessage.className = 'p-3 rounded-sm text-sm bg-red-50 text-red-800 border border-red-200';
        formMessage.classList.remove('hidden');

        console.error('Form submission error:', error);
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send Booking Request';
      }
    });
  }

  // Initialize when DOM is loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingModal);
  } else {
    initBookingModal();
  }
</script>
