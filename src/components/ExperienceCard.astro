---
import OptimizedImage from './OptimizedImage.astro';

// Props interface for the experience card
export interface Props {
  image: string;
  imageAlt: string;
  title: string;
  duration: string;
  description?: string;
  price?: number;
  slug?: string;
  location?: string;
  difficulty?: 'Easy' | 'Moderate' | 'Challenging';
  season?: string;
  isExclusive?: boolean;
}

const {
  image,
  imageAlt,
  title,
  duration,
  description,
  price,
  slug = '',
  location,
  difficulty,
  season,
  isExclusive = false
} = Astro.props;

// Guard: detect missing or broken slugs at build time
const hasValidSlug = !!slug && slug !== '#' && !slug.includes('undefined');
if (!hasValidSlug) {
  console.warn(`[ExperienceCard] Missing or invalid slug for "${title}" — received: "${slug}"`);
}
---
<article class="h-full">
<div class="group bg-white border border-gray-100 rounded-sm overflow-hidden shadow-sm transition-all duration-400 ease-out flex max-w-[450px] md:max-w-[560px] flex-col h-full hover:-translate-y-0.5 hover:shadow-lg hover:border-[#5b7297]">
  <div class="relative aspect-[4/3] overflow-hidden flex-shrink-0">
    <OptimizedImage
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover transition-transform duration-700 ease-out brightness-95 group-hover:scale-[1.02] group-hover:brightness-100"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      loading="lazy"
    />
    {duration && (
      <div class="absolute top-5 right-5 bg-white/40 backdrop-blur-sm px-2 py-1 rounded-sm text-xs sm:text-sm font-light text-white tracking-wider uppercase border border-[#5b7297]/15">
        {duration}
      </div>
    )}
    {isExclusive && (
      <div class="absolute top-5 left-5 bg-[#5b7297]/90 backdrop-blur-sm px-2 py-1 rounded-sm text-xs sm:text-sm font-light text-white tracking-wider uppercase border border-white/20">
        Exclusive
      </div>
    )}
  </div>

  <div class="p-7 sm:p-5 md:p-7 flex flex-col flex-1 bg-white">
    <div class="mb-4 border-b border-gray-50 pb-4">
      <h3 class="text-lg sm:text-xl md:text-2xl font-normal text-[#5b7297] leading-tight mb-2 tracking-tight line-clamp-2 min-h-[3.5rem]">{title}</h3>
      <div class="flex items-center gap-2 text-xs sm:text-sm font-normal text-gray-400 uppercase tracking-wider">
        {location && <span>{location}</span>}
        {location && season && <span>•</span>}
        {season && <span>{season}</span>}
      </div>
    </div>

    {description && (
      <p class="text-gray-500 leading-relaxed mb-6 text-sm sm:text-base md:text-lg font-light line-clamp-3 flex-1">{description}</p>
    )}

    <div class="flex justify-between items-center gap-5 pt-5 border-t border-gray-50 md:flex-row flex-col md:items-center items-stretch md:gap-5 gap-3.5 mt-auto">
      <div class="price-section">
        {price && (
          <span class="text-sm sm:text-base font-normal text-gray-900 tracking-wide">{price.toLocaleString()} Kr</span>
        )}
      </div>

      {hasValidSlug && (
        <a href={slug} class="group/btn inline-flex items-center gap-1.5 px-4 py-2.5 sm:px-5 sm:py-3 bg-transparent text-[#5b7297] no-underline border border-[#5b7297] rounded-sm font-light text-xs sm:text-sm transition-all duration-300 ease-out flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:text-white hover:translate-x-px cta-btn" aria-label={`View details for ${title}`}>
          <span class="relative z-10">View Details</span>
          <svg class="w-4 h-4 transition-transform duration-300 ease-out opacity-80 group-hover/btn:translate-x-0.5 group-hover/btn:opacity-100" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
</article>
<style>
  /* Line clamp utilities */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA Button hover effect */
  .cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #5b7297;
    transform: translateY(-100%);
    transition: transform 0.8s ease;
    z-index: 1;
  }

  .cta-btn:hover::before {
    transform: translateY(0);
  }

  /* Line clamp for description */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
