---
import OptimizedImage from './OptimizedImage.astro';

// Props interface for the blog card
export interface Props {
  image: string;
  imageAlt: string;
  title: string;
  excerpt: string;
  publishDate: string;
  readingTime: string;
  categories: string[];
  slug?: string;
  author?: string;
  lang?: 'en' | 'fr';
}

const {
  image,
  imageAlt,
  title,
  excerpt,
  publishDate,
  readingTime,
  categories,
  slug = '#',
  author = 'Lilja Tours',
  lang = 'en'
} = Astro.props;

// Translations
const translations = {
  en: {
    readMore: 'Read More',
    by: 'By'
  },
  fr: {
    readMore: 'Lire la suite',
    by: 'Par'
  }
};

// Category name translations (English to French)
const categoryTranslations: Record<string, string> = {
  'Itineraries': 'Itinéraires',
  'Tops': 'Tops',
  'Info': 'Info',
  'Photographies': 'Photographies',
  'Hotels': 'Hôtels',
  'Excursions': 'Excursions',
  'Tours': 'Circuits',
  'News': 'Actualités',
  'Travel Guides': 'Guides de Voyage'
};

// Get display name for category based on language
function getCategoryDisplayName(category: string): string {
  if (lang === 'fr' && categoryTranslations[category]) {
    return categoryTranslations[category];
  }
  return category;
}

const t = translations[lang];

// Format date based on language
const formattedDate = new Date(publishDate).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Helper function to convert category name to URL slug
function categoryToSlug(category: string): string {
  return category.toLowerCase().replace(/\s+/g, '-');
}

// Get the correct blog base path for category links
const blogBasePath = lang === 'fr' ? '/fr/blog' : '/blog';
---
<article class="h-full">
<div class="group bg-white border border-gray-100 rounded-sm overflow-hidden shadow-sm transition-all duration-400 ease-out flex max-w-[450px] md:max-w-[560px] flex-col h-full hover:-translate-y-0.5 hover:shadow-lg hover:border-[#5b7297]">
  <div class="relative aspect-[16/9] overflow-hidden flex-shrink-0">
    <OptimizedImage
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover transition-transform duration-700 ease-out brightness-95 group-hover:scale-[1.02] group-hover:brightness-100"
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      loading="lazy"
    />
    <div class="absolute top-5 right-5 bg-white/40 backdrop-blur-sm px-2 py-1 rounded-sm text-xs sm:text-sm font-light text-white tracking-wider uppercase border border-[#5b7297]/15">
      {readingTime}
    </div>
  </div>

  <div class="p-7 sm:p-5 md:p-7 flex flex-col flex-1 bg-white">
    <div class="mb-4 border-b border-gray-50 pb-4">
      <h3 class="text-lg sm:text-xl md:text-2xl font-normal text-[#5b7297] leading-tight mb-3 tracking-tight line-clamp-2 min-h-[3.5rem]">{title}</h3>
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <span class="text-xs sm:text-sm font-normal text-gray-400 tracking-wide">{formattedDate}</span>
        {categories && categories.length > 0 && (
          <div class="flex gap-1.5 flex-wrap">
            {categories.slice(0, 2).map(category => (
              <a
                href={`${blogBasePath}/${categoryToSlug(category)}/`}
                class="text-xs font-normal text-[#5b7297] bg-[#5b7297]/5 px-2 py-0.5 rounded-sm tracking-wide hover:bg-[#5b7297]/10 transition-colors duration-200 no-underline"
              >
                {getCategoryDisplayName(category)}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <p class="text-gray-500 leading-relaxed mb-6 text-sm sm:text-base md:text-lg font-light flex-1 line-clamp-3">{excerpt}</p>

    <div class="flex justify-between items-center gap-5 pt-5 border-t border-gray-50 mt-auto">
      <span class="text-xs sm:text-sm font-light text-gray-400 tracking-wide">{t.by} {author}</span>

      <a href={slug} class="group/btn inline-flex items-center gap-1.5 px-4 py-2.5 sm:px-5 sm:py-3 bg-transparent text-[#5b7297] no-underline border border-[#5b7297] rounded-sm font-light text-xs sm:text-sm transition-all duration-300 ease-out flex-shrink-0 tracking-wide uppercase relative overflow-hidden hover:text-white hover:translate-x-px cta-btn" aria-label={`Read article: ${title}`}>
        <span class="relative z-10">{t.readMore}</span>
        <svg class="w-4 h-4 transition-transform duration-300 ease-out opacity-80 group-hover/btn:translate-x-0.5 group-hover/btn:opacity-100" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</div>
</article>
<style>
  /* Line clamp utilities */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* CTA Button hover effect */
  .cta-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: #5b7297;
    transform: translateY(-100%);
    transition: transform 0.8s ease;
    z-index: 1;
  }

  .cta-btn:hover::before {
    transform: translateY(0);
  }

  /* Mobile responsive adjustments */
  @media (max-width: 768px) {
    .cta-btn {
      justify-content: center;
      font-size: clamp(0.85rem, 2vw, 1rem);
      padding: 12px 20px;
    }
  }

  @media (max-width: 480px) {
    .cta-btn {
      font-size: clamp(0.9rem, 2.2vw, 1.05rem);
      padding: 14px 22px;
    }
  }
</style>
