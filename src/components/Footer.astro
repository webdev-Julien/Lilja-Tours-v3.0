    <!-- Footer Bottom -->
    <div class="footer-divider w-full h-px bg-gradient-to-r from-transparent via-white/20 to-transparent mb-8"></div>
    <div class="flex flex-col md:flex-row justify-between items-center py-8 text-center md:text-left gap-4">
      <p class="text-sm md:text-base font-light text-white/60 m-0 tracking-wide">© 2024 Lilja Tours ehf. {t.footer.allRightsReserved}.</p>
      <div class="flex flex-col md:flex-row gap-4 md:gap-8">
        <a href={u.privacyPolicy[currentLang]} class="text-sm md:text-base font-light text-white/60 no-underline tracking-wide transition-colors duration-300 hover:text-white/90">{t.footer.privacyPolicy}</a>
        <a href={u.termsConditions[currentLang]} class="text-sm md:text-base font-light text-white/60 no-underline tracking-wide transition-colors duration-300 hover:text-white/90">{t.footer.termsConditions}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer link underline effect */
  .footer-link::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1px;
    background: #5b7297;
    transition: width 0.3s ease;
  }

  .footer-link:hover::before {
    width: 100%;
  }

  /* Social link hover effects */
  .social-link:hover .social-icon,
  .social-link:hover svg {
    fill: white;
  }

  /* Mobile responsive adjustments for social grid */
  @media (max-width: 768px) {
    .social-links {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  @media (max-width: 480px) {
    .social-links {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }
</style>
</style>