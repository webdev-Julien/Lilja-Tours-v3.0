            <svg class="w-6 h-6 sm:w-4.5 sm:h-4.5 lg:w-6 lg:h-6 fill-white/80 transition-colors duration-300 group-hover:fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          </a>

          <a href="https://www.pinterest.com/LiljaTours/" class="social-link flex items-center justify-center p-4 sm:p-2 lg:p-4 bg-white/5 rounded-full transition-all duration-300 border border-white/10 aspect-square hover:bg-[#5b7297] hover:-translate-y-1 hover:shadow-xl hover:border-[#5b7297]" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Pinterest">
