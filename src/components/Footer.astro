---
// Footer.astro
import { translations, urls } from '../i18n/translations';
import type { Language } from '../i18n/translations';
import OptimizedImage from './OptimizedImage.astro';

export interface Props {
  currentLang?: 'en' | 'fr';
}

const { currentLang = 'en' } = Astro.props;
const t = translations[currentLang as Language];
const u = urls;
---

<footer class="bg-gradient-to-br from-gray-900 to-gray-700 text-white pt-24 relative">
  <div class="max-w-7xl mx-auto px-8">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-16 lg:gap-12 mb-16">

      <!-- Company Info Section -->
      <div class="flex flex-col gap-8 lg:order-1 order-1">
        <div class="flex items-center gap-4 mb-4 justify-center lg:justify-start">
          <OptimizedImage src="/logos/topbar-logo.webp" alt="Lilja Tours" class="h-12.5 w-auto brightness-0 invert" widths={[200, 400]} sizes="200px" loading="lazy" />
          <h3 class="text-xl md:text-2xl font-normal tracking-wide text-white m-0">Lilja Tours ehf.</h3>
        </div>

        <div class="flex flex-col gap-2 items-center lg:items-start text-center lg:text-left">
          <p class="text-sm md:text-base font-light text-white/80 m-0 tracking-wide">Kennitala: 480621-0260</p>
          <p class="text-sm md:text-base font-light text-white/80 m-0 tracking-wide">VAT Number: 141759</p>
          <p class="text-sm md:text-base font-light text-white/80 m-0 tracking-wide">Address: Hólabraut 15, 220 Hafnarfjordur</p>
        </div>

        <div class="mt-4 text-center lg:text-left">
          <OptimizedImage src="/logos/travel-agency-iceland.jpg" alt="Official Travel Agency License Iceland" class="w-3/4 sm:w-2/5 lg:w-3/4 h-auto rounded shadow-2xl transition-transform duration-300 hover:scale-105 mx-auto lg:mx-0" widths={[300, 600]} sizes="300px" loading="lazy" />
        </div>
      </div>

      <!-- Navigation Links Section -->
      <div class="text-center lg:text-left lg:order-2 order-2">
        <h4 class="text-base md:text-lg font-normal tracking-wider text-white m-0 mb-6 uppercase">{t.footer.explore}</h4>
        <ul class="list-none p-0 m-0 flex flex-col gap-3">
          <li><a href={u.dayTours[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.dayTours}</a></li>
          <li><a href={u.multidayTours[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.multidayTours}</a></li>
          <li><a href={u.transfers[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.transfers}</a></li>
          <li><a href={u.experiences[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.experiences}</a></li>
          <li><a href={u.blog[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.blog}</a></li>
          <li><a href={u.contact[currentLang]} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.contact}</a></li>
        </ul>
      </div>

      <!-- Leave a Review Section -->
      <div class="text-center lg:text-left lg:order-3 order-3">
        <h4 class="text-base md:text-lg font-normal tracking-wider text-white m-0 mb-2 uppercase">{t.footer.leaveReview}</h4>
        <p class="text-sm md:text-base font-light text-white/60 m-0 mb-6">{t.footer.leaveReviewSubtitle}</p>
        <ul class="list-none p-0 m-0 flex flex-col gap-3">
          <li><a href="https://www.tripadvisor.com/UserReviewEdit-g189970-d24131838-Lilja_Tours-Reykjavik_Capital_Region.html" target="_blank" rel="noopener noreferrer" class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.tripAdvisor}</a></li>
          <li><a href="https://g.page/r/CbNDYZ1h13gREBM/review" target="_blank" rel="noopener noreferrer" class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.googleReview}</a></li>
          <li><a href="https://www.trustpilot.com/review/lilja-tours.com" target="_blank" rel="noopener noreferrer" class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{t.footer.trustPilot}</a></li>
        </ul>

        <!-- Travel Advisors Section -->
        <div class="mt-8 pt-6 border-t border-white/10">
          <h4 class="text-base md:text-lg font-normal tracking-wider text-white m-0 mb-2 uppercase">{currentLang === 'en' ? 'Travel Advisors' : 'Agents de voyage'}</h4>
          <p class="text-sm md:text-base font-light text-white/60 m-0 mb-4">{currentLang === 'en' ? 'Partner with us' : 'Devenez partenaire'}</p>
          <a href={currentLang === 'en' ? '/travel-advisors/' : '/fr/conseillers-voyage/'} class="footer-link text-white/80 no-underline text-sm md:text-lg font-light tracking-wide transition-all duration-300 relative pl-0 hover:text-white hover:translate-x-1.5">{currentLang === 'en' ? 'B2B Partnership' : 'Partenariat B2B'}</a>
        </div>
      </div>

      <!-- Social & Contact Section -->
      <div class="text-center lg:text-left lg:order-4 order-4">
        <h4 class="text-base md:text-lg font-normal tracking-wider text-white m-0 mb-6 uppercase">{t.footer.connectWithUs}</h4>
        <div class="grid grid-cols-3 lg:grid-cols-3 gap-4 lg:gap-4 mt-2">
          <a href="https://www.instagram.com/lilja.tours/" class="social-link flex items-center justify-center p-4 sm:p-2 lg:p-4 bg-white/5 rounded-full transition-all duration-300 border border-white/10 aspect-square hover:bg-[#5b7297] hover:-translate-y-1 hover:shadow-xl hover:border-[#5b7297]" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">
            <svg class="w-6 h-6 sm:w-4.5 sm:h-4.5 lg:w-6 lg:h-6 fill-white/80 transition-colors duration-300 group-hover:fill-white" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
