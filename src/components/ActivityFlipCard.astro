---
import OptimizedImage from './OptimizedImage.astro';

export interface Props {
  name: string;
  description: string;
  day: number;
  image: string;
  alt: string;
  currentLang?: 'en' | 'fr';
}

const { name, description, day, image, alt, currentLang = 'en' } = Astro.props;

const translations = {
  en: { day: 'Day' },
  fr: { day: 'Jour' }
};

const t = translations[currentLang];
---

<div class="flip-card-container">
  <div class="flip-card">
    <!-- Front -->
    <div class="flip-card-front">
      <img src={image} alt={alt} class="flip-card-image" loading="lazy" />
      <div class="flip-card-overlay"></div>
      <div class="flip-card-content">
        <span class="day-badge">{t.day} {day}</span>
        <h4 class="activity-name">{name}</h4>
      </div>
    </div>

    <!-- Back -->
    <div class="flip-card-back">
      <div class="flip-card-content-back">
        <span class="day-badge-back">{t.day} {day}</span>
        <h4 class="activity-name-back">{name}</h4>
        <p class="activity-description">{description}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .flip-card-container {
    width: 100%;
    aspect-ratio: 1 / 1;
    perspective: 1000px;
  }

  .flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s ease-in-out;
    cursor: pointer;
  }

  .flip-card-container:hover .flip-card {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 0.125rem;
    overflow: hidden;
  }

  .flip-card-front {
    background-color: #374151;
  }

  .flip-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .flip-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.2) 50%, transparent 100%);
  }

  .flip-card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem;
    text-align: center;
  }

  .day-badge {
    display: inline-block;
    background: var(--secondary, #5b7297);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 0.125rem;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .activity-name {
    color: white;
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .flip-card-back {
    background: white;
    transform: rotateY(180deg);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #e5e7eb;
  }

  .flip-card-content-back {
    padding: 1.25rem;
    width: 100%;
    text-align: center;
  }

  .day-badge-back {
    display: inline-block;
    background: var(--secondary, #5b7297);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 0.125rem;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .activity-name-back {
    color: #111827;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
  }

  .activity-description {
    color: #374151;
    font-size: 0.8rem;
    line-height: 1.5;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 768px) {
    .flip-card-content,
    .flip-card-content-back {
      padding: 1rem;
    }

    .activity-name,
    .activity-name-back {
      font-size: 0.9rem;
    }

    .activity-description {
      font-size: 0.75rem;
      -webkit-line-clamp: 4;
    }
  }
</style>
